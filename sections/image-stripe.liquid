<style>
  .image-wrapper {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
  }
  
  .image-wrapper .stripe-image {
      display: block;
      position: relative;
      width: 100%;
      height: auto;
  }
  {% for block in section.blocks %}
    .block-{{ block.id }} {
      width: {{block.settings.width_number }}%;
    }
  {% endfor %}

  @media only screen and (max-width: 768px) {
    .image-wrapper .stripe-image .image-container {
      width: 100%;
      position: relative;
      display: block;
    }
    {% for block in section.blocks %}
      .block-{{ block.id }} {
        width: {{block.settings.width_number_mobile }}%;
      }
    {% endfor %}
  }
</style>
<div class="image-container-stripe">
  <div class="image-wrapper">
    {% for block in section.blocks %}
      <div class="image-container block-{{ block.id }}" {{ block.shopify_attributes }}><img src="{{ block.settings.block_image | image_url }}" class="stripe-image"></div>
    {% endfor %}
  </div>
</div>
{% schema %}
  {
    "name": "Image Stripe",
    "settings": [],
    "blocks": [
      {
        "type": "image",
        "name": "image",
        "settings": [
          {
            "type": "image_picker",
            "label": "Image",
            "id": "block_image"
          },
          {
            "type": "text",
            "label": "Width in %",
            "id": "width_number",
            "default": "33"
          },
          {
            "type": "text",
            "label": "Width in % (mobile)",
            "id": "width_number_mobile",
            "default": "33"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Image Stripe"
      }
    ]
  }
{% endschema %}