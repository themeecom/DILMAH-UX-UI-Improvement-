          },
          {
            "type": "text",
            "id": "overline",
            "label": "Small heading"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Heading"
          },
          {
            "type": "textarea",
            "id": "subheading",
            "label": "Subheading"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          },
          {
            "type": "text",
            "id": "link_text",
            "label": "Button text",
            "default": "Shop now",
            "info": "The entire slide will become a link if this setting is left blank."
          },
          {
            "type": "header",
            "content": "Style"
          },
          {
            "type": "range",
            "id": "overlay_opacity",
            "label": "Overlay opacity",
            "min": 0,
            "max": 100,
            "step": 10,
            "default": 20
          },
          {
            "type": "color",
            "id": "overlay_color",
            "label": "Overlay color",
            "default": "#000000"
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "Text color",
            "default": "#ffffff"
          },
          {
            "type": "range",
            "id": "text_max_width",
            "label": "Max width of text",
            "min": 16,
            "max": 50,
            "step": 1,
            "default": 48
          },
          {
            "type": "select",
            "id": "horizontal_text_position",
            "label": "Horizontal text position",
            "options": [
              { "value": "left", "label": "Left" },
              { "value": "center", "label": "Center" },
              { "value": "right", "label": "Right" }
            ],
            "default": "left"
          },
          {
            "type": "select",
            "id": "vertical_text_position",
            "label": "Vertical text position",
            "options": [
              { "value": "top", "label": "Top" },
              { "value": "middle", "label": "Middle" },
              { "value": "bottom", "label": "Bottom" }
            ],
            "default": "middle"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "christmas Columns",
        "category": "Image",
        "blocks": [
          {
            "type": "slide",
            "settings": {
              "title": "This is your slideshow",
              "subheading": "Use it to set your brand's tone and create a first impression with your customers. Vibrant imagery with a lot of background accent works well for a full-screen effect.",
              "horizontal_text_position": "left",
              "vertical_text_position": "middle"
            }
          },
          {
            "type": "slide",
            "settings": {
              "title": "This is your slideshow",
              "subheading": "Use it to set your brand's tone and create a first impression with your customers. Vibrant imagery with a lot of background accent works well for a full-screen effect.",
              "horizontal_text_position": "left",
              "vertical_text_position": "middle"
            }
          }
        ]
      }
    ]
  }
{% endschema %}