{% render 'brand-images' with
  id: section.id,
  aspect_ratio: section.settings.aspect_ratio,
  timer: section.settings.timer,
  slides: section.blocks,
subheading:section.blocks,
%}

<style>
/*--- 2nd Area Colums - Start --*/
.ecom_brand_txt_wrapper{
  display:none;
}
.Brand-col {
    width: 33.33%;
    margin: 0px 0px;
}
.Brand-col .slideshow__image--mobile {
    display: block;
}
.brand {
  margin:0;
}
.ecom_gift_card_img{
  width:100%;
}

/*--- brand slider on mobile ---*/
@media only screen and (max-width:768px){
  .mobBrand{
/*     display:block; */
  }
  .brand.image-slide{
    display:none!important;
  }
  .slick-list.draggable{
    height:200vw;
  }
}

  @media only screen and (min-width:768px){
  .mobBrand{
    display:none;
  }
  .brand.image-slide{
    display:flex!important;
  }
}
/*--- 2nd Area Colums - End --*/  


/*--- 3rd Area - start --*/

.slideshow__content-inner--right>* {
    margin-left: unset;
}
.slideshow__content-inner--right {
    text-align: center;
    width: 60%;
    float: right;
  margin-top:6rem;
}
p.slideshow__subheading.type-body-regular {
    text-align: center !important;
}
a.slideshow__link.bttn {
    border: 2px solid white;
    background: transparent;
    width: fit-content;
    margin: 0 auto;
}

@media only screen and (max-width:960px){
  .slideshow__content-inner--right {
    text-align: center;
    width: 100%;
    float: unset;
    margin-top: 10rem;
}
}
/*--- 3rd Area - End --*/

/*-- 4th area - Start --*/
  
.slide2 .slideshow__content {
    background-color: #000000c2;
}

/*-- 4th area - End --*/

/*-- 5th area Styles - Start --*/
.slide3 {
    background-color: red;
}


.slide3 .slideshow__slide--full_height .slideshow__image .image__img{
    width: 100% !important;
    height: auto !important;
    object-fit: contain;
}
.ecom_img_tst.image.image--567421108410.slideshow__image.slideshow__image--desktop {
    height: 79% !important;
}

.slide3 .slideshow__slide--full_height .slideshow__content{
position:absolute;
  top:0;
  bottom:unset;
margin-top:20%;
}
@media only screen and (max-width:960px){
  .slide3 {
    height: 45vh;
    overflow: hidden;
  }
  .slide3 .slideshow__slide--full_height .slideshow__content .slideshow__content-inner p {
    margin-top: 4px !important;
  }
}

  @media only screen and (min-width:960px) and (max-width:1250px){
  .slide3 {
    height: 42vw;
    overflow: hidden;
}
}
  
@media only screen and (min-width:1250px){
  .slide3 {
    height: 35.7vw;
    overflow: hidden;
}
}
/*-- end --*/

/*-- set footer margin to 0 --*/
.ecom-footer1 {
    margin-top: 0 !important;
}

/*--btn sizes --*/
a.slideshow__link.bttn {
    font-size: 20px;
}
</style>


{% schema %}
  {
    "name": "christmas Columns",
    "class": "section-dynamic",
    "settings": [
      {
        "type": "select",
        "id": "aspect_ratio",
        "label": "Image aspect ratio",
        "options": [
          { "value": "full_height", "label": "Full height" },
          { "value": "3_2", "label": "Cropped" },
          { "value": "unconstrained", "label": "Natural" }
        ],
        "default": "full_height"
      },
     {
            "type": "richtext",
            "id": "text",
            "label": "Text"
          },
{
            "type": "image_picker",
            "id": "logo1",
            "label": "logo1",
            "info": "logo1."
          },
{
            "type": "image_picker",
            "id": "logo2",
            "label": "logo2",
            "info": "logo2."
          },
{
            "type": "image_picker",
            "id": "minilogo1",
            "label": "minilogo1",
            "info": "minilogo1."
          },
{
            "type": "image_picker",
            "id": "minilogo2",
            "label": "minilogo2",
            "info": "minilogo2."
          },
{
            "type": "image_picker",
            "id": "minilogo3",
            "label": "minilogo3",
            "info": "minilogo3."
          }
    ],
    "max_blocks": 8,
    "blocks": [
      {
        "type": "slide",
        "name": "Slide",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image",
            "info": "1440 x 960px minimum recommended."
          },
          {
            "type": "image_picker",
            "id": "mobile_image",
            "label": "Mobile image",
