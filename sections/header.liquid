{% render 'frame--header' with
  id: section.id,
  detect_menu_length: section.settings.detect_menu_length,
  header_style: section.settings.header_style,
  nav_alignment: section.settings.nav_alignment,
  logo: section.settings.logo,
  logo_max_size: section.settings.logo_max_size,
  menu: section.settings.menu,
  transparent_index_header_enabled: section.settings.transparent_index_header_enabled,
  transparent_logo: section.settings.transparent_logo,
  transparent_header_foreground_color: section.settings.transparent_header_foreground_color,
  transparent_header_border_color: section.settings.transparent_header_border_color,
  transparent_header_border_opacity: section.settings.transparent_header_border_opacity,
  show_locale_selector: section.settings.show_locale_selector,
  show_currency_selector: section.settings.show_currency_selector,
  blocks: section.blocks
%}

{% render 'drawer-menu' with
  menu: section.settings.menu,
  logo: section.settings.logo,
  logo_max_size: section.settings.logo_max_size,
%}

{% schema %}
  {
    "name": "Header",
    "class": "header-section",
    "settings": [
      {
        "type": "header",
        "content": "Header"
      },
      {
        "type": "select",
        "id": "header_style",
        "label": "Header style",
        "options": [
          { "value": "default", "label": "Inline links" },
          { "value": "always-mobile", "label": "Menu icon" }
        ],
        "default": "default"
      },
      {
        "type": "select",
        "id": "nav_alignment",
        "label": "Navigation alignment",
        "options": [
            { "value": "left", "label": "Left"},
            { "value": "center", "label": "Center"},
            { "value": "right", "label": "Right"}
        ],
        "default": "left",
        "info": "Alignment will only apply if Header style is Inline links"
      },
      {
        "type": "checkbox",
        "id": "detect_menu_length",
        "label": "Enable menu length detection",
        "default": false,
        "info": "Switches the menu style to the Menu icon if the menu exceeds the width of the container."
      },
      {
        "type": "header",
        "content": "Language Selector"
      },
      {
        "type": "checkbox",
        "id": "show_locale_selector",
        "label": "Show language selector",
        "default": false
      },
      {
        "type": "header",
        "content": "Currency Selector"
      },
      {
        "type": "checkbox",
        "id": "show_currency_selector",
        "label": "Show currency selector",
        "default": false
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_max_size",
        "min": 50,
        "max": 300,
        "step": 10,
        "label": "Custom logo size",
        "default": 150
      },
      {
        "type": "link_list",
        "id": "menu",
        "label": "Main menu",
        "default": "main-menu"
      },
      {
        "type": "header",
        "content": "Transparent header"
      },
      {
        "type": "checkbox",
        "id": "transparent_index_header_enabled",
        "label": "Enable on home page",
        "default": false
      },
      {
        "type": "image_picker",
        "id": "transparent_logo",
        "label": "Logo image"
      },
      {
        "type": "color",
        "id": "transparent_header_foreground_color",
        "label": "Text color",
        "info": "Only applicable if transparent header is enabled.",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "transparent_header_border_color",
        "label": "Border color",
        "info": "Only applicable if transparent header is enabled.",
        "default": "#ffffff"
      },
      {
        "type": "range",
        "id": "transparent_header_border_opacity",
        "min": 0,
        "max": 100,
        "step": 10,
        "label": "Border opacity",
        "default": 10
      },
      {
        "type": "header",
        "content": "Cart Page Navigation"
      },
      {
        "type": "checkbox",
        "label": "Show Less Menu in Cart",
        "default": false,
        "id": "show_less_menu_in_cart"
      },
      {
        "type": "url",
        "id": "cart_less_link",
        "label": "Link",
        "visible_if": "{{ section.settings.show_less_menu_in_cart }}",
      },
      {
        "type": "text",
        "label": "Cart less link text",
        "id": "cart_less_link_text",
        "visible_if": "{{ section.settings.show_less_menu_in_cart }}"
      }
    ],
    "blocks": [
      {
        "type": "mega_nav",
        "name": "Mega nav",
        "settings": [
          {
            "type": "text",
            "id": "dropdown_parent_link",
            "label": "Dropdown parent link",
            "info": "Name the link in the main menu that you'd like the Mega nav to appear from."
          },
          {
            "type": "image_picker",
            "id": "mega_nav_featured_image",
            "label": "Mega nav featured image"
          },
          {
            "type": "text",
            "id": "featured_image_heading",
            "label": "Featured image caption"
          },
          {
            "type": "text",
            "id": "featured_image_link_text",
            "label": "Featured image link text"
          },
          {
            "type": "url",
            "id": "featured_image_link",
            "label": "Featured image link"
          },
          {
            "type": "richtext",
            "id": "feature_text",
            "label": "Strapline text"
          }
        ]
      }
    ]
  }
{% endschema %}
