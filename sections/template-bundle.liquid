    font-weight: normal;
    margin: 0;
    padding: 7px 15px;
    width: 42%;
    font-size: 2rem;
    line-height: 3.8rem;
    box-sizing: border-box;
    vertical-align: middle;
}  
  
li.multicolumn-list__item.active {
    border: 1px solid #ede1e1;
