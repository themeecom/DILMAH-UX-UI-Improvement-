
{% assign modifiers = '' %}
{%- assign has_image = false -%}

{% if section.settings.image != blank %}
  {%- assign has_image = true -%}
  {% assign modifiers = modifiers | append: ' contact--has-image' %}
{% endif %}

{% capture content %}
  {%- if page.content != blank -%}
    <div class="contact__text rte">{{ page.content }}</div>
  {%- endif -%}

  
{% endcapture %}

<section class="contact section{{ modifiers }} ecom-contact_page">
  
  <div class="contact-DES">
  
      {% if has_image %}
      <div class="contact__container">
        <div class="contact__image">
          {% render 'image' with image: section.settings.image, wrapper_class: 'borders' %}
        </div>
        <div class="contact__content">
          <div class="contact__content-inner">
            <h1 class="contact__heading type-heading-1 mt0 mb3">{{ page.title }}</h1>

          </div>
        </div>
      </div>
    {% else %}
<!--       <div class="contact__image">
          <img src="https://cdn.shopify.com/s/files/1/0558/2920/1082/files/newsletter_pic.png?v=1661428367">
        </div> -->
      <header class="contact_header page__header center">
        <div class="newsletterCoverWithPic">
          <div class="newsletterTxtArea">
<!--             <h1 class="contact__heading type-heading-1 mt0 mb3 newletterTxt">{{ page.title }} </h1> -->
<!--             <h2 class="ecom_contact__heading newletterTxt">Subscribe and get 10% off your first purchase!</h2> -->
            <!-- <h3 class="ecom_news_heading newletterTxt">Subscribe and get 10% off your first purchase. Login to avail this discount.</h3> -->
          </div>
        </div>
        <div class="smallMobNewsLetterPic">
          <img src="https://cdn.shopify.com/s/files/1/0558/2920/1082/files/newsletter_pic.png?v=1661428367">
        </div>
      </header>

      
    {% endif %}
  
    
    {{content}}
  </div>
  
  
  <div class="contact_form_tr">
    
    {% comment  %}}
  <div class="right-info">
  
     <ul>
        <li class="telephone">
          <span class="icon">
          </span>
          <span class="icon-text">
          <span >
            <font style="vertical-align: inherit;">
               <font style="vertical-align: inherit;color: #999;">Phone number: </font>
            </font>
            <span>
              <a href="tel:+44 (0) 1933 422 060"><font style="vertical-align: inherit;">
                <font style="vertical-align: inherit;">+ 94 11 482 2000 </font>
                </font>
              </a>
            </span>
          </span>
     
          </span>
          
        </li>
        
        <li class="email">
          <span class="icon"></span> <span><font style="vertical-align: inherit;"><font style="vertical-align: inherit;">Email: </font></font>
          <span><a href="mailto:orders@dilmahtea.com">
            <font style="vertical-align: inherit;">
              <font style="vertical-align: inherit;">orders@dilmahtea.com</font></font></a></span></span></li>
        <!--<li class="email"><span>Postadres:&nbsp;<span>&nbsp;&nbsp;&nbsp;</span></span></li>-->
        <li class="address">
          <span class="icon"></span>
          <span class="address_text">
          <span class="head"><font style="vertical-align: inherit;"><font style="vertical-align: inherit;">
            
            Dilmah Ceylon Tea Company PLC, </font></font></span> 
            
            <span><font style="vertical-align: inherit;">
            <font style="vertical-align: inherit;">111, Negombo Road,</font></font></span>
            <span><font style="vertical-align: inherit;"><font style="vertical-align: inherit;">Peliyagoda (11830), </font></font></span>
            <span><font style="vertical-align: inherit;"><font style="vertical-align: inherit;">Sri Lanka.
</font></font></span>
                        
          </span> 
        </li>
   
    
    </ul>
  
  
  
  </div>
    {% endcomment %}
    
  <div class="form-wrapper">
    <h3 class="ecom_news_heading newsLetterSubsTxt">Subscribe and get 10% off your first purchase. Login to avail this discount.</h3>
{% render 'newsletter-contact' %}
  </div>
  </div>
  
</section>
<style>
  .ecom_news_heading {
    text-align: left;
    color: #007b84;
  }
  
  @media only screen and (min-width: 768px) {
  /* For desktop: */
  
section.contact.section.ecom-contact_page {
  padding: 0 calc(10px * 10);
   margin: 42px 0;
} 
}

  
  
 section.contact.section.ecom-contact_page {
    display: block;
}
 
    .mid-content {
    width: 100%;
    float: left;
}
  
.contact__inner {
  max-width: 1252px;
}  
