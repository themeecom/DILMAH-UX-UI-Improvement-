.fieldset.fieldset-row {
    width: 100%;
    float: left;
    margin: 0 0 7px;
}  
.fieldset-row .field {
    width: 50%;
    float: left;
 
}  
.right-info ul {
    padding: 44px 41px 48px;
    background: #ededed;
    float: left;
    margin: 0;
    border-radius: 12px;
} 
  
.right-info ul li {
    list-style: none;
    float: left;
    width: 100%;
    border-bottom: 1px solid #ccc;
    margin-top: 0;
    margin-bottom: 1rem;
    padding-bottom: 20px;
}  
.mid-content .form-wrapper .fieldset .fieldset.fieldset-row .field:first-child {
    padding-right: 21px;
}  
.mid-content .form-wrapper .fieldset .fieldset.fieldset-row.wide .field:first-child {
    padding-right: 0;
}  
 
.fieldset-row .field.topic {
    width: 100%;
}  
.field.comment.required {
    width: 100%;
} 
  
.field.choice.newsletter {
    width: 100%;
    text-align: left;
    float: left;
    position: relative;
    color: #007c85 !important;
    font-weight: bold;
    padding-left: 34px;
} 

 .field.choice.newsletter input {
   
       position: absolute;
    top: 0;
    left: 0;
    width: 21px;
    height: 21px;
    padding: 0;
    margin: 0;
    z-index: 100;
    opacity: 1;
    cursor: pointer;
} 
  

  .field.choice.is_confirmed {
    position: relative;
}
  
.field.choice.is_confirmed input {
      
    position: absolute;
    top: 0;
    left: 0;
    width: 21px;
    height: 21px;
    padding: 0;
    margin: 0;
    z-index: 100;
    opacity: 1;
    cursor: pointer;
}
 .field.choice.is_confirmed label {
    padding-left: 32px;
} 
  
  
button.action.submit.primary {
    background-image: none;
    background: #2d9699;
    border: 1px solid #2d9699;
    color: #fff;
    cursor: pointer;
    display: inline-block;
    font-family: 'signika_regular','Helvetica Neue',Helvetica,Arial,sans-serif;
    font-weight: 400;
    padding: 7px 15px;
    width: 180px;
    font-size: 1.4rem;
    line-height: 3.4rem;
    box-sizing: border-box;
    vertical-align: middle;
}  
 .actions-toolbar {
    padding: 14px;
}
li.telephone span.icon:before {
    -webkit-font-smoothing: antialiased;
    font-size: 27px;
    line-height: 27px;
    color: #007c85;
    content: "\e937";
    font-family: 'dilmah-icons';
    vertical-align: middle;
    display: inline-block;
    font-weight: normal;
    overflow: hidden;
    speak: none;
    text-align: center;
}  
 li.email span.icon:before {
    -webkit-font-smoothing: antialiased;
    font-size: 25px;
    line-height: 24px;
    color: #007c85;
    content: "\e943";
    font-family: 'dilmah-icons';
    vertical-align: middle;
    display: inline-block;
    font-weight: normal;
    overflow: hidden;
    speak: none;
   text-align: center;
 
 } 
  
  
  
  li.address span.icon:before{
      -webkit-font-smoothing: antialiased;
    font-size: 32px;
    line-height: 32px;
    color: #007c85;
    content: "\e942";
    font-family: 'dilmah-icons';
    vertical-align: middle;
    display: inline-block;
    font-weight: normal;
    overflow: hidden;
    speak: none;
    text-align: center;
  }
  
.mid-content .right-info ul li.telephone .icon {
    margin: 8px 22px 0 0;
    display: inline-block;
    text-decoration: none;
} 
  
   .mid-content .right-info ul li .icon {
    width: 45px;
    height: 45px;
}
  .mid-content .right-info ul li span {
    font-size: 1.6rem;
    color: #007c85;
}
  
  .mid-content .right-info ul li span.time {
    float: left;
    font-size: 1.4rem;
    color: #666;
}
  
  .mid-content .right-info ul li span span a {
    color: #007c85;
    text-decoration: none;
}
 .mid-content .right-info ul li.address .icon {
    width: 45px;
    height: 110px;
    margin: 0;
    padding-left: 1px;
    display: inline-block;
    text-decoration: none;
}  
 li.telephone {
    display: flex;
} 
  
li.address {
    display: flex;
}  
span.address_text {
