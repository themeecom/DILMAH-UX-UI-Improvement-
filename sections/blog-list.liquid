{% assign blog = blogs[section.settings.blog] %}
{% assign blog_url-1 = blog.url %}
{% assign onboarding = true %}

{% assign blog-2 = blogs[section.settings.blog-2] %}
{% assign blog_url-2 = blog-2.url %}
{% assign onboarding = true %}

{% assign blog-3 = blogs[section.settings.blog-3] %}
{% assign blog_url-3 = blog-3.url %}
{% assign onboarding = true %}

{% assign blog-4 = blogs[section.settings.blog-4] %}
{% assign blog_url-4 = blog-4.url %}
{% assign onboarding = true %}




{% if section.settings.blog != 'none' and blog.articles.size > 0 %}
  {% assign onboarding = false %}
  {% assign blog_url = blog.url %}
{% endif %}

{% assign article_count = 3 %}
{% if onboarding == false and blog.articles.size < article_count %}
  {% assign article_count = blog.articles.size %}
{% endif %}
{% assign article_count = 2 %}
<script
  type="application/json"
  data-section-id="{{ section.id }}"
  data-section-type="dynamic-blog-posts">
</script>

