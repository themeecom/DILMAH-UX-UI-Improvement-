<section class="ecom-blog-tea-ideas blogpost--count-{{ article_count }} ">
  
  <h2 class="Tea_for_everything">tea for everything</h2>
  
  {% if section.settings.title != blank %}
  
  
  <div class="ecom_two_sections">
   
    <h2 class="hvr-float-shadow home-section--title tab_head_1 active" data-id="tab_1">
       <img loading="lazy" src = {{section.settings.image1|img_url: '100x'}}/>
      <span> {{ section.settings.title | escape }}</span>
    </h2>
  {% endif %}
  
  {% if section.settings.title2 != blank %}
     
     <h2 class="hvr-float-shadow home-section--title tab_head_2" data-id="tab_2">
       <img loading="lazy" src = {{section.settings.image2|img_url: '100x'}}/>
       <span> {{ section.settings.title2 | escape }}</span>
    </h2>
  
  {% endif %}
  
  {% if section.settings.title3 != blank %}
     
    <h2 class="hvr-float-shadow home-section--title tab_head_3" data-id="tab_3">
      <img loading="lazy" src = {{section.settings.image3|img_url: '100x'}}/>
      <span> {{ section.settings.title3 | escape }}</span>
    </h2>
  {% endif %}
  
  {% if section.settings.title4 != blank %}
    
    <h2 class="hvr-float-shadow home-section--title tab_head_4" data-id="tab_4">
       <img  loading="lazy"src = {{section.settings.image4|img_url: '100x'}}/>
      <span> {{ section.settings.title4 | escape }}</span>
    </h2>
  {% endif %}
    
    
</div>
  
  
  <ul class="home-section--content blogposts--inner" data-blog-posts>
    {% if onboarding %}
      {% for i in (1..article_count) %}
        {%
          render 'article-excerpt',
          onboarding: true
        %}
      {% endfor %}
    {% else %}
	<div class="tab_sec ecom_first tab_1  {{article_count}}">
      <div class="tab_row">
      {% for article in blog.articles limit: article_count %}
        
      
        
        {%
          render 'article-excerpt',
          article: article
        %}
      {% endfor %}
    
         <li class="left-image" >
             <img src="{{section.settings.image1-banner|img_url: '400x'}}" style="width: 100%;border-radius: 19px;" loading="lazy">
            <a href="{{blog_url-1}}" class="shop_now_btn CollectionDrop">EXPLORE ALL</a>
        </li>
        
        
        
      </div>
      
	</div>
	<div class="tab_sec ecom_hidden ecom_second tab_2">
       <div class="tab_row">
      {% for article in blog-2.articles limit: article_count %}
     
        {%
          render 'article-excerpt',
          article: article
        %}
      {% endfor %}
     <li class="left-image" >
             <img src="{{section.settings.image2-banner|img_url: '400x'}}" style="width: 100%;border-radius: 19px;" loading="lazy">
            <a href="{{blog_url-2}}" class="shop_now_btn CollectionDrop">EXPLORE ALL</a>
        </li>
         
         
      </div>
      
      
      
	</div>
	<div class="tab_sec ecom_hidden tab_3">
       <div class="tab_row">
      {% for article in blog-3.articles limit: article_count %}
     
        {%
          render 'article-excerpt',
          article: article
        %}
      {% endfor %}
         <li class="left-image" >
             <img src="{{section.settings.image3-banner|img_url: '400x'}}" style="width: 100%;border-radius: 19px;" loading="lazy">
            <a href="{{blog_url-3}}" class="shop_now_btn CollectionDrop">EXPLORE ALL</a>
        </li>
         
      </div>
	
	</div>
	<div class="tab_sec ecom_hidden tab_4">
       <div class="tab_row">
      {% for article in blog-4.articles limit: article_count %}
        {%
          render 'article-excerpt',
          article: article
        %}
      {% endfor %}
         
         <li class="left-image" >
             <img src="{{section.settings.image4-banner|img_url: '400x'}}" style="width: 100%;border-radius: 19px;" loading="lazy">
            <a href="{{blog_url-4}}" class="shop_now_btn CollectionDrop">EXPLORE ALL</a>
        </li> 
         
      </div>
	
	</div>
    
    {% endif %}
  </ul>
  

  <div class="blogposts--footer">
    <a class="blogposts--footer-link button-primary" href="{{ blog_url }}">
     
      {% comment %}
      {{ 'blog.general.see_more' | t }}
      {% endcomment %}

    </a>
  </div>
</section>

