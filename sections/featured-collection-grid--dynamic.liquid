  <div class="howmaywe-perant" style="display:none">
   <div class="howmaywe-sub">
  
        <div id = "howmaywe">
          <h2>{{section.settings.Htitle}}</h2>
          <p class="sub1"> {{section.settings.HStitle}}</p>
          <p class="sub2">{{section.settings.Hdetail}}</p>


        
          <div class="howmaywe-taglist">
                {% assign tags = section.settings.tagList| downcase | split: ',' %}

              {% for tag in tags %}
            <div class="howmaywe-taglist-sec">  <input type="checkbox"  name="{{ tag }}" value="{{ tag }}"><label for="{{ tag }}"> {{ tag }}</label></div>
              {% endfor %}
        </div>
          
          
          <div class="howmaywe-btn-row">
            
            <button class="btn howmaywe-btn btn-reset">Reset</button>
            <button class="btn howmaywe-btn btn-submit ">Submit</button>
            
          </div>
          
          
