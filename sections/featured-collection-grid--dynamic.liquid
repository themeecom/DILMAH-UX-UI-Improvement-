<div class = "ecom-product-grid">
  <div class="featured-collection-tab-section-ecom">
 <div class="ecom-product-grid-header"> 
  <h2 class="ecom_text_rm_recm rich-text__title type-heading-1 ma0 mb3 {{section.settings.title}}">Teamaker's Recommendations</h2>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              {%capture apps%}                                                                                                                                                                                                                                                                               

  <div id = "ecom-title-set" data-ecom-expanded="yes">
