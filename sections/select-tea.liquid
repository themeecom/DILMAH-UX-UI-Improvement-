            "min": 10,
            "max": 100,
            "step": 10,
            "default": 50
          },
          {
            "type": "text",
            "id": "title",
            "label": "Heading",
            "default": "Column heading"
          },
          {
            "type": "textarea",
            "id": "subheading",
            "label": "Subheading",
            "default": "Column text"
          },
          {
            "type": "range",
            "id": "text_max_width",
            "label": "Max width of text",
            "min": 16,
            "max": 50,
            "step": 1,
            "default": 36
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          },
          {
            "type": "text",
            "id": "link_text",
            "label": "Link text",
            "default": "Read more"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Select Tea",
        "category": "Text",
        "blocks": [
          {
            "type": "column",
            "settings": {
              "title": "Column one",
              "subheading": "Start here. Introduce your vision, or explain why what you do or sell is superior to your competitors.",
