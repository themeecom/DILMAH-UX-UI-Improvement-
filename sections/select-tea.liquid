} */
  .def-link {
    display: inline-block;
    vertical-align: top;
    height: 45px;
    line-height: 45px;
    background: #007b84;
    color: #fff !important;
    font-weight: 600;
    border-radius: 25px;
    padding: 0 58px;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all .4s;
}
  
  @media (min-width: 768px){
  .def-link {
    height: 40px;
    line-height: 40px;
    padding: 0 25px;
    font-size: 13px;
}
  }
 
  @media (min-width: 1400px){
      .def-link {
        padding: 0 30px;
