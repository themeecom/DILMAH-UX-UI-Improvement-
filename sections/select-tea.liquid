        "default": 36
      },
{
            "type": "image_picker",
            "id": "bgimage",
            "label": "Image"
          }
    ],
    "max_blocks": 8,
    "blocks": [
      {
        "type": "column",
        "name": "Column",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "range",
            "id": "image_max_width",
