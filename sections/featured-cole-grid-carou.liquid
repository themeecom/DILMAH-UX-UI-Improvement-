{% schema %}
  {
    "name": "featured cole grid carou",
    "class": "section-dynamic section-borderable carousel",
    "settings": [
      {
        "type": "text",
        "id": "custom_class",
        "label": "Custom Class"
      },
      {
        "type": "header",
        "content": "Section style"
      },
      {
        "type": "select",
        "id": "section_style",
        "label": "Style",
        "default": "default",
        "options": [
          {
            "value": "default",
            "label": "Default"
          },
          {
            "value": "contrast",
            "label": "Contrast"
          }
        ]
      },
      {
        "type": "header",
        "content": "Section content"
      },
{
        "type": "text",
        "id": "title1",
        "label": "Heading",
        "default": "Featured collection"
      },
      {
        "id": "collection",
        "type": "collection",
        "label": "Collection"
      },
{
        "type": "text",
        "id": "title2",
        "label": "Heading",
        "default": "Featured collection"
      },

{
        "id": "collection2",
        "type": "collection",
        "label": "Collection2"
      },
{
        "type": "text",
        "id": "title3",
        "label": "Heading",
        "default": "Featured collection"
      },
{
        "id": "collection3",
        "type": "collection",
        "label": "Collection3"
      },
{
        "type": "text",
        "id": "title4",
        "label": "Heading",
        "default": "Featured collection"
      },
{
        "id": "collection4",
        "type": "collection",
        "label": "Collection4"
      },

{
        "type": "text",
        "id": "title5",
        "label": "Heading",
        "default": "Featured collection"
      },
{
        "id": "collection5",
        "type": "collection",
        "label": "Collection5"
      },

{
        "type": "text",
        "id": "title6",
        "label": "Heading",
        "default": "Featured collection"
      },
      {
        "id": "collection6",
        "type": "collection",
        "label": "Collection6"
      },
      {
        "type": "text",
        "id": "title7",
        "label": "Heading collection 7",
        "default": "Featured collection"
      },
      {
        "id": "collection7",
        "type": "collection",
        "label": "Collection7"
      },
      {
        "id": "products_per_row",
        "type": "range",
        "label": "Columns",
        "default": 3,
        "min": 2,
        "max": 4,
        "step": 1
      },
      {
        "id": "total_row",
        "type": "range",
        "label": "Rows",
        "default": 2,
        "min": 1,
        "max": 3,
        "step": 1
      },
      {
        "id": "aspect_ratio",
        "type": "select",
        "label": "Image aspect ratio",
        "options": [
          { "label": "Natural", "value": "natural" },
          { "label": "Square (1:1)", "value": "square" },
          { "label": "Landscape (3:2)", "value": "landscape" },
          { "label": "Portrait (2:3)", "value": "portrait" }
        ],
        "default": "natural"
      },
      {
        "type": "text",
        "id": "overline",
        "label": "Small heading",
        "default": "Collection"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Featured collection"
      },
      {
        "type": "font_picker",
        "label": "Font for Main title",
        "id": "font_for_main_title",
        "default": "mariposa_sans_n7"
      },

      {
        "type": "header",
        "content": "How May We Serve"
      },


    {
        "type": "text",
        "id": "Htitle",
        "label": "Heading",
        "default": "How may we serve you?"
      },
{
        "type": "text",
        "id": "HStitle",
        "label": "SUB Heading",
        "default": "Not Sure which dilmah"
      },

 {
        "type": "textarea",
        "id": "Hdetail",
        "label": "Detail",
        "default": "Add a subheading to provide more details about this "
      },
      {
        "type": "textarea",
        "id": "tagList",
        "label": "Tag List",
        "default": "Add a subheading to provide more details about this collection."
      },
      
      {
        "type": "select",
        "id": "heading_alignment",
        "label": "Heading alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          }
        ]
      },
      {
        "type": "range",
        "id": "text_max_width",
        "label": "Max width of text",
        "min": 16,
        "max": 50,
        "step": 1,
        "default": 36
      }
    ],
    "presets": [
      {
        "name": "Ecom featured collection grid carousel",
        "category": "Collection"
      }
    ]
  }
{% endschema %}
