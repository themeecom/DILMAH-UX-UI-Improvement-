<script>
    function ecom_tax_calculation() {
        let taxRates = [];
        {%- for block in section.blocks -%}
            tax_rate.push({ "tag_list": {{ block.settings.tag_list | json }}, "tax_rate": {{ block.settings.tax_rate | json }} });
        {%- endfor -%}
    }
</script>
{% schema %}
{
    "name": "Tax Calculation",
    "settings": [
        {
            "type": "text",
            "label": "Excluding tax text in the product page",
            "default": "(ex BTW)",
            "id": "excluding_tax_product_page"
        },
        {
            "type": "text",
            "label": "Excluding tax text in the collection pages",
            "id": "excluding_tax_in_collection_page",
            "default": "ex BTW"
        }
    ],
    "blocks": [
        {
            "type": "tax_group",
            "name": "Tax Group",
            "settings": [
                {
                    "type": "textarea",
                    "label": "Tag List",
                    "info": "Add the tag list seperate by comma",
                    "id": "tag_list"
                },
                {
                    "type": "textarea",
                    "label": "Tax rate",
                    "info": "Follow this pattern, CountryCode-TaxPercentage. Ex: NL-21,BE-21,DE-19,LU-17,LK-21",
                    "id": "tax_rate"
                }
            ]
        }
    ]
}
{% endschema %}