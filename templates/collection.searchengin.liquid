

{% paginate collection.products by 99999999 %}
  
  {% for product in collection.products %}
    <script id="prod_{{ product.id }}" type="application/ld+json">
      {

          "title":"{{ product.title }}",
        
          "price":"{{ product.price |  money_without_currency }}",
        
          "category":["{{ product.type }}"],
        
          "image_url":"{{ product.featured_image | image_url }}",
        
          "action_url":"{{ shop.secure_url  | append: product.url}}"
        
      }
    </script>

  {% endfor %}

{% endpaginate %}


