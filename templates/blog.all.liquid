<div class="collection__container ecom_blog_row">
<div class="left_side">

  <!-- ecom blog sort START  -->
  {%- assign blog_ids = blank -%}
  {%- assign blog_handles = blank -%}

  {%- for link in linklists.blog-categories.links -%}
    {%- assign blog = link.object -%}
    
    {%- for article in blog.articles -%}
      {%- assign blog_ids = blog_ids | append: article.id | append: "," -%}
      {%- assign blog_handles = blog_handles | append: article.handle | append: "," -%}
    {%- endfor -%}
  {%- endfor -%}

  {%- assign blog_ids = blog_ids | split: "," | sort | reverse -%}
  {%- assign blog_handles = blog_handles | split: "," -%}

  <!-- blog_ids {{ blog_ids | size }} -->

  {%- assign sortad_handles = blank -%}

  {%- for blog_id in blog_ids -%}
    {%- for blog_post_handle in blog_handles -%}
      {%- assign blog_post = articles[blog_post_handle] -%}

      {%- assign blog_post_id = blog_post.id | append: "" -%}
      
      {%- if blog_id == blog_post_id -%}
        {%- assign sortad_handles = sortad_handles | append: blog_post.handle | append: "," -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}

  {%- assign sortad_handles = sortad_handles | split: "," -%}

  {% comment %} try for sort based on updated time of the blog (not sure working)
    {% assign edited_time_blog_posts = blank %}
  
      {% for sortad_handle in blog_handles %}
        {% assign article = articles[sortad_handle] %}
        {% assign article_update_date = article.updated_at | date: '%s'  %} (this is for get date as timestamp)
        {% assign edited_time_blog_posts = edited_time_blog_posts | append: article.id | append: article_update_date | append: "," %}
      {% endfor %}
  
    <!-- edited_time_blog_posts {{ edited_time_blog_posts }} -->
    <!-- edited_time_blog_posts {{ edited_time_blog_posts | split: "," | sort | reverse }} -->
  
    {% assign edited_time_blog_posts = edited_time_blog_posts | split: "," | sort | reverse %}
    
    {%- for blog_id in edited_time_blog_posts -%}
      {%- for blog_post_handle in blog_handles -%}
        {%- assign blog_post = articles[blog_post_handle] -%}
  
        {%- assign blog_post_id = blog_post.id | append: "" -%}
        
        {%- if blog_id == blog_post_id -%}
          {%- assign sortad_handles = sortad_handles | append: blog_post.handle | append: "," -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  
  {% endcomment %}
  
  {% for sortad_handle in sortad_handles %}
    {% assign article = articles[sortad_handle] %}
    
    <div class="blog__articles-container mt3">
      <div class="blog__articles_ecom" data-reversed>
        <article class="blog__article relative{{ article_modifiers }}">
          {%- if article.image -%}
            <a href="{{ article.url }}">
              <div
                class="blog__article-image lazyload"
                data-bgset="{%- render 'responsive-bg-image', image: article.image -%}"
                role="img"
                aria-label="{{ article.image.alt }}"
              ></div>
              {%- if forloop.first and layout == 'latest_featured' -%}
                <div class="blog__article-featured-badge ttu lh-title bg-sale white">{{ 'blogs.article.featured' | t }}</div>
              {%- endif -%}
            </a>
          {%- endif -%}
          <div class="blog__article-content">

            <div>
              {%- capture date -%}{{ article.published_at | date: "%B %d, %Y" }}{%- endcapture -%}
              <div class="type-heading-meta meta mt1 blog_date-ecom">{{ date }}</div>

              <h3 class="blog__article-title blog__article-heading type-heading-1-small">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h3>
              
              <div class="blog__article-excerpt type-body-regular mt3">{{ article.excerpt_or_content | strip_html | truncate: 200 }}</div>
            </div>
             <a href="{{ article.url }}" class="bttn  bttn--inline mt4 reade_moreBtn">{{ 'blogs.article.read_more' | t }}</a>
          </div>
        </article>
      </div>
    </div>
  {% endfor %}
  
  <!-- ecom blog sort END  -->
  
  {% comment %}    COMMENT OUT SORTED BLOGS HERE
    {%- for link in linklists.blog-categories.links -%}
     {%- assign blog = link.object -%}
      <div class="blog__articles-container mt3">
            <div class="blog__articles_ecom" data-reversed>
              
            
              {%- for article in blog.articles | sort: 'created_at' | reverse -%}
    
                {%- capture article_modifiers -%}
                  {%- if forloop.first and layout == 'latest_featured' -%} is-featured {%- endif -%}
                  {%- if article.image -%} has-image {%- endif -%}
                {%- endcapture -%}
    
                <article class="blog__article relative{{ article_modifiers }}">
                  {%- if article.image -%}
                    <a href="{{ article.url }}">
                      <div
                        class="blog__article-image lazyload"
                        data-bgset="{%- render 'responsive-bg-image', image: article.image -%}"
                        role="img"
                        aria-label="{{ article.image.alt }}"
                      ></div>
                      {%- if forloop.first and layout == 'latest_featured' -%}
                        <div class="blog__article-featured-badge ttu lh-title bg-sale white">{{ 'blogs.article.featured' | t }}</div>
                      {%- endif -%}
                    </a>
                  {%- endif -%}
                  <div class="blog__article-content">
    
                    <div>
                      {%- capture date -%}{{ article.published_at | date: "%B %d, %Y" }}{%- endcapture -%}
                      <div class="type-heading-meta meta mt1 blog_date-ecom">{{ date }}</div>
    
                      <h3 class="blog__article-title blog__article-heading type-heading-1-small">
                        <a href="{{ article.url }}">{{ article.title }}</a>
                      </h3>
    
                      
                      <div class="blog__article-excerpt type-body-regular mt3">{{ article.excerpt_or_content | strip_html | truncate: 200 }}</div>
                    </div>
                    
                     <a href="{{ article.url }}" class="bttn  bttn--inline mt4 reade_moreBtn">{{ 'blogs.article.read_more' | t }}</a>
    
                  </div>
    
                 
                </article>
              {%- endfor -%}
            </div>
          </div>
    
    {%- endfor -%}
  {% endcomment %}
</div>
  
<div class="right_slide ii">
<ul class="parent">
{%- for link in linklists.blog-categories.links -%}
<li class="blog_slid_menu"><span class="icon_blog_menu"></span><a href="{{ link.url }}">{{ link.title }}</a>
{%- if link.links != blank -%}
  <ul class="child">
    {%- for child_link in link.links -%}  
    <li><a href= "{{ child_link.url }}">{{ child_link.title }}</a>
    {%- if child_link.links != blank -%}
      <ul class="grandchild">
      {%- for grandchild_link in child_link.links -%}  
        <li><a href= "{{ grandchild_link.url }}">{{ grandchild_link.title }}</a></li>
      {%- endfor -%}
      </ul>
    {%- endif -%}   
    </li>
    {%- endfor -%}
  </ul> 
{%- endif -%} 
</li>
{%- endfor -%}
</ul>
  
</div>
  </div>