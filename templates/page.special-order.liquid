{% comment %}
{% render 'pages--page' %}
{% endcomment %}




<section
  class="page section faq_page"
  data-section-id="{{ id }}"
  data-section-type="page"
>
  <header class="page__header center">
    {% unless overline == blank %}
      <div class="page__overline overline ma0 mb3 tc">
        {{ overline }}
      </div>
    {% endunless %}

    <h1 class="type-heading-1 tc mt0 mb5">{{ page.title }}</h1>
  </header>

  {%- if blocks.size > 0 -%}
    <div class="about__grid about__grid--{{ blocks.size }}">
      {%- for block in section.blocks -%}
        <div class="about__block about__block--{{ forloop.index }}">

          {%- if block.settings.image == blank and block.settings.video_url == blank -%}
            <div class="placeholder-image">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}

          {%- if block.settings.image != blank -%}
            {% render 'image' with
              image: block.settings.image,
              disable_style: true
            %}
          {%- endif -%}

          {% if block.settings.video_url != blank %}
            <video class="about__block-video" autoplay playsinline loop muted src="{{ block.settings.video_url }}"></video>
          {% endif %}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="page__content center">
    <div class="rte">
      {{ page.content }}
    </div>
    <p>Please fill below form and send us your requirements, we will contact you within 24 - 48 Hours.
</p>
    <br>
    
  </div>
  
  
  
  <div class="special_order_row">
  
  
  <div class="special_form">
  
        {% form 'contact', class: 'contact__form' %}

          {% if form.posted_successfully? %}
            <p class="contact__success">
              {{ 'contact.form.post_success' | t }}
            </p>
          {% endif %}

          {{ form.errors | default_errors }}

          <div class="contact__form-input-side-by-side2 special_order">
            <div class="relative">
               <label for="ContactFormName" class="lable_special">
                 Full Name <span>*</span>
                </label>
                <input
                  type="text"
                  name="contact[full_name]"
                  id="ContactFormName"
                  class="input"
                  placeholder="e.g. John"
                  value=""  required>
              
            </div>

           
          </div>

     <div class="contact__form-input-side-by-side special_order">
           <div class="relative">
               <label for="ContactFormName" class="lable_special">
                 Email <span>*</span>
                </label>
                           
              <input
        type="email"
        name="contact[email]"
        id="ContactFormEmail"
        class="input"
        placeholder="e.g. name@domain.com"
        value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
        spellcheck="false"
        autocomplete="off"
        autocapitalize="off"
      required>
             
              
            </div>

            <div class="relative">
              
              <label for="ContactFormEmail" class="lable_special">
                Phone number<span>*</span>
              </label>
              
           
              
              <input  type="tel" class="form-field-input form-field-text input-reset input w-100 input" name="contact[Phone_Number]"  id="mobile" value="{{ cart.attributes["Phone Number"] }}" required>

              
            </div>
       
       
       
       
          </div>
    
    
     <div class="contact__form-input-side-by-side special_order">
           <div class="relative">
               <label for="ContactFormName" class="lable_special">
                 Product Category
                </label>
             
             
             
             <select name="contact[product_category]"  id="product_category" title="Product Category" class="input">
               <option value="">Select Product Category</option>
               <option value="Premium Ceylon Single Origin Tea">Premium Ceylon Single Origin Tea</option>
               <option value="Exceptional Range">Exceptional Range</option>
               <option value="Single Region Selection">Single Region Selection</option>
               <option value="Watte">Watte</option>
               <option value="Fun Tea Selection">Fun Tea Selection</option>
               <option value="Infusion">Infusion</option>
               <option value="Organic Tea Selection">Organic Tea Selection</option>
               <option value="Natural Green Tea Selection">Natural Green Tea Selection</option>
               <option value="Vivid Tea Selection">Vivid Tea Selection</option>
               <option value="Silver Jubilee Gourmet">Silver Jubilee Gourmet</option>
               <option value="Tea Maker's Private Reserve">Tea Maker's Private Reserve</option>
               <option value="Ceylon Orange Pekoe">Ceylon Orange Pekoe</option>
               <option value="Gift of Tea">Gift of Tea</option>
               <option value="t-Series, Designer Gourmet Teas">t-Series, Designer Gourmet Teas</option>
               <option value="Decaffeinated Tea">Decaffeinated Tea</option>
               <option value="Ceylon Silver tips">Ceylon Silver tips</option>
               <option value="Accessories">Accessories</option>
               <option value="Ceylon Gold">Ceylon Gold</option>
               <option value="Tea Cordial">Tea Cordial</option>
               <option value="Help me Find the Perfect Tea">Help me Find the Perfect Tea</option>
             </select>
             
             
             
             
             
             
             
              
            </div>

            <div class="relative">
              
              <label for="ContactFormEmail" class="lable_special">
               Product Type
              </label>
              
              
              
              <select name="contact[product_type]"  id="product_type" title="Product Type" class="input">
                 <option value="">Select Product Type</option>
                <option value="Black Tea">Black Tea</option>
                
                <option value="Green Tea">Green Tea</option>
                    <option value="White Tea">White Tea</option>
                <option value="Oolong Tea">Oolong Tea</option>
                
                <option value="Earl Grey">Earl Grey</option>
                <option value="Herbal Infusion">Herbal Infusion</option>
                <option value="Flavoured Tea">Flavoured Tea</option>
            
                
                <option value="Decaf Tea">Decaf Tea</option>
                 <option value="Organic Tea">Organic Tea</option>
                
                <option value="Iced Tea">Iced Tea </option>
              </select>
              
              
              
              
            </div>
          </div>
    
    
     <div class="contact__form-input-side-by-side special_order">
           <div class="relative">
               <label for="ContactFormName" class="lable_special">
                 Tea format
                </label>
         
             
             
             <select name="contact[tea_format]"  id="tea_format" title="Tea format" class="input">
               <option value="">Select Tea Format</option>
               <option value="Loose Leaf Tea">Loose Leaf Tea</option>
               <option value="Pot Bags/ Tagless Bags">Pot Bags/ Tagless Bags</option>
               
               
               <option value="String & Tag Bags/Cup Bags">String & Tag Bags/Cup Bags</option>
               
               <option value="Individually Paper Wrapped Bags">Individually Paper Wrapped Bags</option>
               
               
               <option value="Individually Foil Wrapped Bags">Individually Foil Wrapped Bags</option>
                
               
               
               <option value="Luxury Leaf Tea Bags">Luxury Leaf Tea Bags</option>
                <option value="Tea Sachets">Tea Sachets</option>
             </select>
             
             
              
       </div>
    
    </div>
    
    
    
         

          <div class="relative">
            <label for="ContactFormMessage" class="lable_special">
              Message
            </label>
            
            
            <textarea
              rows="5"
              name="contact[body]"
              id="ContactFormMessage"
              class="input-reset input w-100"
              placeholder="Write any additional information here..."
            >

              {%- if form.body -%}
                {{- form.body -}}
              {%- endif -%}
            </textarea>
            
          </div>

    
    
         <div class="relative"  style="
    display: flex;
    justify-content: flex-start;
    align-content: center;
    align-items: center;
">
