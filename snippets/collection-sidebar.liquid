<div class="ecom_sidebar collection-sidebar">
  <div class="ecom_sorts sort-by--container collection-sidebar-filter">
    <label class="ecom_sort_label" for="sort-by">Sort by</label> 
    <select id="sort-by" class="ecom_sort_by_select sort-by">
      {% for option in collection.sort_options %}
      <option value="{{ option.value }}"{% if option.value == collection.sort_by %} selected{% endif %}>
        {% if option.value == "created-descending"%}
          New
        {% elsif option.value == "best-selling" %}
          Most Popular
        {% elsif option.value == "price-ascending" %}
          Lowest price
        {% elsif option.value == "price-descending" %}
          Rarest
        {% else %}  
          {{ option.name }}
        {% endif %}
      </option>
      {% endfor %}
    </select>
  </div>
<!-- -->
  <p class="ecom-title-filter">Filters</p>
  {% if collection.all_tags.size > 0 and show_filters %}

    {%- if filter_type == 'by_tag' -%}
      <div class="ecom_sidebar_group collection-sidebar__group" data-group="{{ 'collections.tags.title' | t }}">
        {%- assign heading = 'collections.tags.title' | t -%}
        {% render 'collection-sidebar-heading' with heading: heading %}
        <ul>
        {% for tag in collection.all_tags %}
          {% assign is_in_category = false %}
          {% assign cat = tag | split: '_' | first %}
          {% unless cat == tag %}
            {% if categories contains cat %}
              {% assign is_in_category = true %}
            {% endif %}
          {% endunless %}

          {%- capture tag_text -%}
            {% if is_in_category %}
              {{ tag | remove_first: cat | remove_first: '_' }}
            {% else %}
              {{ tag }}
            {% endif %}
          {%- endcapture -%}

          {% if current_tags contains tag %}
            {% assign is_active = true %}
            {% assign url = tag_text | link_to_remove_tag: tag | split: '"' %}
            {% assign url = url[1] %}
          {% else %}
            {% assign is_active = false %}
            {% assign url = tag_text | link_to_add_tag: tag | split: '"' %}
            {% assign url = url[1] %}
          {% endif %}

          {% render 'filter-item' with
            type: 'checkbox',
            label: tag_text,
            active: is_active,
            url: url,

            key: 'tag',
            val: tag
          %}
        {% endfor %}
        </ul>
      </div>
    {%- endif -%}


    {%- if filter_type == 'by_group' -%}
      
      {% assign activeFilters = settings.enable_tags %}
      {% assign activeFilters = activeFilters | split:"," %}
      
      {% for category in categories %}
        {%- assign current_category = category | escape | strip -%}
        
        {%- unless activeFilters contains current_category -%}
          {%- continue -%}
        {%- endunless -%}
        
        {%- assign heading = category -%}
        <div class="collection-sidebar__group" data-group="{{ heading }}" data-here>
          {% render 'collection-sidebar-heading' with heading: heading %}
          <ul>
            {% for tag in collection.all_tags %}
              {% assign cat = tag | split: '_' | first %}

              {% if cat != tag and category == cat %}
                {% assign label = tag | remove_first: cat | remove_first: '_' %}

                {% if current_tags contains tag %}
                  {% assign is_active = true %}
                  {% assign url = label | link_to_remove_tag: tag | split: '"' %}
                  {% assign url = url[1] %}
                {% else %}
                  {% assign is_active = false %}
                  {% assign url = label | link_to_add_tag: tag | split: '"' %}
                  {% assign url = url[1] %}
                {% endif %}

                {% render 'filter-item' with
                  type: 'checkbox',
                  label: label,
                  active: is_active,
                  url: url,

                  key: 'tag',
                  val: tag
                %}
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      {% endfor %}

    {%- endif -%}
  {% endif %}

{% comment %}{% endcomment %}
  {% if show_sort %}
    {%- assign heading = 'collections.sorting.title' | t -%}
    <div class="collection-sidebar__group" data-group="{{ heading }}" style="
    position: absolute;
    background: #ffffff;
    width: 170%;
    left: 100;
    display: none !important;
">
{% comment %{% render 'collection-sidebar-heading' with heading: heading %}{% endcomment %}
      <ul style="
    display: none;
    flex-wrap: wrap;
">
        {% for option in collection.sort_options %}
          {%- assign is_active = false -%}
          {%- if option.value == collection.sort_by -%}
            {%- assign is_active = true -%}
          {%- endif -%}
          {% render 'filter-item' with
            label: option.name,
            type: 'radio',
            active: is_active,
            url: '#',

            key: 'sort',
            val: option.value
          %}
        {% endfor %}
      </ul>
      <!--    added on 10/6/2021    -->
      <div class="ecom_sorts sort-by--container">
        <label class="ecom_sort_label" for="sort-by">Sort by</label> 
        <select id="sort-by" class="ecom_sort_by_select sort-by">
          {% for option in collection.sort_options %}
          <option value="{{ option.value }}"{% if option.value == collection.sort_by %} selected{% endif %}>
            
            {% if option.value == "created-descending"%}
              New
            {% elsif option.value == "best-selling" %}
              Most Popular
            {% elsif option.value == "price-ascending" %}
              Lowest price
            {% elsif option.value == "price-descending" %}
              Rarest
            {% else %}  
              {{ option.name }}
            {% endif %}
          </option>
          {% endfor %}
        </select>
      </div>
      <!--    added on 10/6/2021 | END    -->
    </div>
  {% endif %}
</div>

