{% assign gradient_direction = detail_alignment | split: '_' | last %}
{% assign gradient_starting_position = 100 | minus: gradient_length %}

{% assign feature_text_alignment = feature_alignment | split: '_' | first %}
{% assign feature_text_position = feature_alignment | split: '_' | last %}

{% assign modifiers = '' %}

{% if feature_text_position == 'top' %}
  {% assign modifiers = modifiers | append: ' image-with-text-split--feature-text-above' %}
{% endif %}

{% assign modifiers = modifiers | append: ' image-with-text-split--feature-text-' | append: feature_text_alignment %}

<section
  data-section-id="{{ id }}"
  class="section section--full-width image-with-text-split{{ modifiers }} {{ section.settings.custom_class }}"
  {% unless feature_background_color == blank %}
    style="background-color: {{ feature_background_color }};"
  {% endunless %}
>
  <div class="image-with-text-split__featured">

    <div class="image-with-text-split__featured-image">
      {% if feature_link != blank %}
        <a href="{{ feature_link }}">
      {% endif %}

      {% if feature_image != blank %}
        {% render 'image' with image: feature_image %}
      {% else %}
        
      {% endif %}

      {% if feature_link != blank %}
        </a>
      {% endif %}
    </div>

      <div class="slideshow__content2">
    
            <div class="slideshow__content-inner2 slideshow__content-inner--{{ section.settings.horizontal_text_position }} animation__staggered-children-fade-in2">
              {% if section.settings.overline != blank %}
                <h2
                  class="slideshow__overline overline"
                  data-theme-editor-setting="section.{{ id }}.section.{{ section.id }}.overline"
                  style="color: {{ section.settings.text_color }}; max-width: {{ section.settings.text_max_width }}rem;"
                >
                  {{ section.settings.overline }}
                </h2>
              {% endif %}
              {% if section.settings.title != blank %}
                <h2
                  class="slideshow__heading2 type-heading-display2"
                  data-theme-editor-setting="section.{{ id }}.section.{{ section.id }}.title"
                  style="color: {{ section.settings.text_color }}; max-width: {{ section.settings.text_max_width }}rem;"
                >
                  {{ section.settings.title }}
                </h2>
              {% endif %}
              {% if section.settings.subheading != blank %}
                <p
                  class="slideshow__subheading type-body-regular"
                  data-theme-editor-setting="section.{{ id }}.section.{{ section.id }}.subheading"
                  style="color: {{ section.settings.text_color }}; max-width: {{ section.settings.text_max_width }}rem;"
                >
                  {{ section.settings.subheading }}
                </p>
              <div class="btn-shopNow"> <a href="{{ link }}" class="btn-shop">Shop Now</a></div>
              {% endif %}

              {%- if section.settings.link != blank and section.settings.link_text != blank -%}
                <a href="{{ section.settings.link }}" class="slideshow__link bttn {{ horizontal_position }}">{{ section.settings.link_text }}</a>
              {%- endif -%}
            </div>
          </div>
  </div>

  <div class="image-with-text-split__image-wrapper">
    {% if link != blank %}
      <a href="{{ link }}">
    {% endif %}

    <div
      data-bgset="{% render 'responsive-bg-image', image: overlay_image %}"
      role="img"
      aria-label="{{ overlay_image.alt }}"
      class="image-with-text-split__image lazyload"
    >
      {% if overlay_image != blank %}
        {% render 'image' with
          image: overlay_image,
          wrapper_class: "image-with-text-split__image-mobile"
        %}
      {% else %}
        <div class="image-with-text-split__placeholder">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
      {% endif %}

      {% render 'overlay' with
        overlay_opacity: overlay_opacity,
        overlay_color: overlay_color,

        alignment: detail_alignment,
        richtext: image_text,
        text_color: text_color,
        text_max_width: text_max_width,
      %}

      {% if gradient_color != blank %}
        <div
          class="image-with-text-split__gradient-overlay"
          style="background: linear-gradient(to {{ gradient_direction }}, rgba(0, 0, 0, 0) {{ gradient_starting_position }}%, {{ gradient_color }} 100%);"
        ></div>
      {% endif %}
    </div>

    {% if link != blank %}
      </a>
    {% endif %}
  </div>
</section>
