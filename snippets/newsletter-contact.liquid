<script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.15/js/intlTelInput.min.js" integrity="sha512-L3moecKIMM1UtlzYZdiGlge2+bugLObEFLOFscaltlJ82y0my6mTUugiz6fQiSc5MaS7Ce0idFJzabEAl43XHg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>


{% form 'contact', class: 'contact__form' %}

  {% if form.posted_successfully? %}
    <p class="contact__success">
      {{ 'contact.form.post_success' | t }}
    </p>
  {% endif %}

  {{ form.errors | default_errors }}

  <div class="contact__form-input-side-by-side">
    <div class="relative">
      <input
        type="text"
        name="contact[name]"
        id="ContactFormName"
        class="input"
        placeholder="Full Name"
        value="{% if form[name] %}{{ form[name] }}{% elsif customer %}{{ customer.name }}{% endif %}"
      required/>
      <label for="ContactFormName" class="label--above">
        {{ 'contact.form.name' | t }}
      </label>
    </div>

    <div class="relative">
      <input
        type="email"
        name="contact[email]"
        id="ContactFormEmail"
        class="input"
        placeholder="{{ 'contact.form.email' | t }}"
        value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
        spellcheck="false"
        autocomplete="off"
        autocapitalize="off"
      required>
      <label for="ContactFormEmail" class="label--above">
        {{ 'contact.form.email' | t }}
      </label>
    </div>
  </div>

  {% comment %}
  <div>
  <div class="relative">
    <input
      type="tel"
      name="contact[phone]"
      id="mobile"
      class="input-reset input w-100"
      placeholder="{{ 'contact.form.phone' | t }}"
      value="{% if form[phone] %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
      pattern="[0-9\-]*"
    required>
    <label for="ContactFormPhone" class="label--above">
      {{ 'contact.form.phone' | t }}
    </label>
  </div>



 <div class="relative">
    <select name="contact[subject_topic]" id="subject_topic" class="input-reset input w-100">
       <option value="">Subject Topic</option>
      <option value="Compliment">Compliment</option>
      <option value="Complaint">Complaint</option>
      <option value="Product Inquiry">Product Inquiry</option>
      <option value="Other">Other</option>
    </select>
  </div>

  <div class="relative Order_Number" style="display:none">
      <input
        type="text"
        name="contact[Order_Number]"
        id="ContactFormName"
        class="input"
        placeholder="Order Number"
        value=""
      >
      <label for="ContactFormName" class="label--above">
        Order Number
      </label>
    </div>

 <div class="relative Subject" style="display:none">
      <input
        type="text"
        name="contact[Subject]"
        id="ContactFormName"
        class="input"
        placeholder="Subject"
        value=""
      >
      <label for="ContactFormName" class="label--above">
        Subject
      </label>
    </div>



  <div class="relative">
    <textarea
      rows="5"
      name="contact[body]"
      id="ContactFormMessage"
      maxlength="400"
      class="input-reset input w-100"
      placeholder="{{ 'contact.form.message' | t }}"
    required>

      {%- if form.body -%}
        {{- form.body -}}
      {%- endif -%}
    </textarea>
    <label for="ContactFormMessage" class="label--above">
      {{ 'contact.form.message' | t }}
    </label>
  </div>

  
<div class="relative"  style="
    display: flex;
    justify-content: flex-start;
    align-content: center;
    align-items: center;
">
    <input type="checkbox" id="newslatter_chek" name="newslatter_chek" value="newslatter_chek" style="
    width: 16px;
">
    <label for="newslatter_chek"> Signup for Our Newsletter</label>
</div>  
<div class="relative" style="
    display: flex;
    justify-content: flex-start;
    align-content: center;
    align-items: center;height: 28px;margin-bottom: 23px;
" >  
<input type="checkbox" id="privacy" name="privacy" style="
    width: 16px;
" value="privacy" Required>
<label for="privacy">Confirm acceptance of our Privacy Policy</label>
</div>

  </div>
  {% endcomment %}

  <button type="submit" id="submit_btn" class="bttn bttn--full bttn--primary">{% comment %}{{ 'contact.form.submit' | t }}{% endcomment %}SUBSCRIBE</button>

{% endform %}


