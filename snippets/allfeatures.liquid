{% assign modifiers = '' %}

{% assign modifiers = modifiers | append: ' section--' | append: section_style %}

{% unless section_style == 'contrast' %}
{% assign modifiers = modifiers | append: ' section--bordered' %}
{% endunless %}

{% assign modifiers = modifiers | append: ' text-columns--alignment-' | append: text_alignment  %}

{% assign modifiers = modifiers | append: ' collection-list-grid--columns-' | append: columns  %}

{% assign item_width = '' %}

{%- case columns -%}
{%- when 1 -%}
{%- assign item_width = 'full' -%}
{%- when 2 -%}
{%- assign item_width = 'one-half' -%}
{%- when 3 -%}
{%- assign item_width = 'one-third' -%}
{%- when 4 -%}
{%- assign item_width = 'one-quarter' -%}
{%- endcase -%}

<section
         data-section-id="{{ id }}"
         data-section-type="text-columns-with-images"
         class="section text-columns{{ modifiers }} ecom-collection-img"
         >
  {% render 'text-block' with
    id: id,
  modifiers: 'text-columns__intro animation__staggered-children-fade-in',
  heading_alignment: text_alignment,
  text_max_width: text_max_width,
  overline: overline,
  heading: heading,
  text_max_width: text_max_width,
  subheading: subheading,
  link: link,
  link_text: link_text


  %}

  <div class="text-columns__content grid-display grid-display--{{ item_width }} ecom-img-banner">


    <div class = "section0">

      {% render 'image' with image: section.settings.Mimage|img %}
    </div>
    <div class = "section1">

      {% for block in blocks %}


      {% if forloop.index == 5 %}
    </div>
    <div class="section2">
      
      <p class="text_section2">
      
        Our founder made a commitment to the purpose beyond profit. A minimum 15% of our pretax profits directly benefit people and planet. Until 2019 it was 10% and in response to the social and environmental challenges the world face, our founder increased our commitment to humanity,by 50%. These funds are generated by Dilmah Tea and our allied business are used by our MFJ Foundation and Dilmah Conversion to directly. efficiently and effectively fulfill the philosophy of making business a matter of human service.
      
      </p>
      {%endif%}
      <div class="text-columns__feature animates ecom-img-text">
        {%- if block.settings.image != blank -%}
        {% if block.settings.link != blank %}
        <a href="{{ block.settings.link }}" class="mb3 w-100 text-columns__image db" style="max-width: {{ block.settings.image_max_width }}%;">
          {% else %}
          <div class="mb3 w-100 text-columns__image db" style="max-width: 100%;">
            {% endif %}

            {% render 'image' with image: block.settings.image %}

            {% if block.settings.link != blank %}
            </a>
          {% else %}
          </div>
        {%- endif -%}
        {%- endif -%}
        <div class="ecom-collection-text">

          {%- if block.settings.title != blank -%}
          <h3
              class="type-heading-1-small mb3 mt0"
              data-theme-editor-setting="section.{{ id }}.block.{{ block.id }}.title"
              style="max-width: {{ block.settings.text_max_width }}em;"
              >
            {{ block.settings.title }}
          </h3>
          {%- endif -%}
          {% comment %} {% endcomment %}

          {%- if block.settings.subheading != blank -%}
          <p
             class="type-body-regular mt0 mb0"
             data-theme-editor-setting="section.{{ id }}.block.{{ block.id }}.subheading"
             style="max-width: {{ block.settings.text_max_width }}em;"
             >
            {{ block.settings.subheading }}
          </p>
          {%- endif -%}
        </div>
        {%- if block.settings.link != blank and block.settings.link_text != blank -%}
        <a
           href="{{ block.settings.link }}"
           class="bttn bttn--secondary bttn--inline mt4"
           data-theme-editor-setting="section.{{ id }}.block.{{ block.id }}.link_text"
           >
          {{ block.settings.link_text }}
        </a>
        {%- endif -%}
      </div>
      {% endfor %}
    </div></div>
</section>


