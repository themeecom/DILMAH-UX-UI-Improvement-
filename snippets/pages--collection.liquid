{% liquid
  assign grid_modifiers = blank
  assign modifiers = blank

  assign modifiers = modifiers | append: ' collection--pagination-' | append: pagination

  if show_border
    assign modifiers = modifiers | append: ' collection--has-border'
  endif

  if show_filters or show_sort
    assign modifiers = modifiers | append: ' collection--has-filters'
  endif

  case products_per_row
    when 2
      assign grid_modifiers = grid_modifiers | append: ' grid-display--one-half'
    when 3
      assign grid_modifiers = grid_modifiers | append: ' grid-display--one-third'
    when 4
      assign grid_modifiers = grid_modifiers | append: ' grid-display--one-quarter'
  endcase

  assign grid_modifiers = grid_modifiers | append: ' grid-display--has-products'
  assign grid_modifiers = grid_modifiers | append: ' grid-display--' | append: aspect_ratio

  assign paginate_by = per_page

  assign collection_heading = collection.title
  unless show_heading
    assign collection_heading = blank
  endunless

  assign collection_label = blank
  if show_small_heading
    assign collection_label = 'collections.general.collection_label' | t
  endif

  assign paginated = false
  if pagination == 'paginated'
    assign paginated = true
  endif

  assign filters_exist = false

  unless collection.tags.size == 0 and show_sort == false
    assign filters_exist = true
    if filter_style == 'sidebar'
      assign modifiers = modifiers | append: ' collection--has-sidebar'
    endif
  endunless

  assign cat_string = blank
  for tag in collection.all_tags
    if tag contains '_'
      assign category = tag | split: '_' | first
      assign cat_string = cat_string | append: '|' | append: category
    endif
  endfor
  assign categories = cat_string | remove_first: '|' | split: '|' | uniq
%}

<script>
  console.log(`collection tags are {{ categories | join: "," }}`)
</script>
<section
  class="collection{{ modifiers }}"
  data-section-id="{{ id }}"
  data-section-type="collection"
  data-pagination-type="{{ pagination }}"
>
  <script type="application/json" data-tags>
    {% if collection.all_tags.size > 0 %}
      [
        {%- for tag in collection.all_tags -%}
          { "label": "{{ tag | escape }}", "handle": "{{ tag | handleize }}" }
          {%- if forloop.last == false -%}, {%- endif -%}
        {%- endfor -%}
      ]
    {% else %}
      []
    {% endif %}
  </script>

  {% assign proper_alpha = overlay_opacity | divided_by: 100.00 %}

  <style>
    {% if show_collection_image and collection.image %}
      .collection__image-overlay{
        background-color: {{ overlay_color | color_modify: 'alpha', proper_alpha }};
      }

      @media (min-width: 38em) {
        .collection__details {
          color: {{ text_color }};
        }
      }
    {% endif %}
  </style>

  {% paginate collection.products by paginate_by %}
    <div class="collection__container">
        {% comment%}
        <header role="banner" class="collection__header">
          <div
            class="
              collection__details
              {% if show_collection_image == false or collection.image == blank %}collection__details--no-image{% endif %}
            ">

            {% assign collection_subheading = "" %}

            {% if show_description %}
              {% assign collection_subheading = collection.metafields.description.collection %}
            {% endif %}

            {% render 'text-block' with
              heading_alignment: heading_alignment,
              text_max_width: text_max_width,
              overline: collection_label,
              heading: collection_heading,
              subheading: collection_subheading,
            %}
          </div>

          {% if show_collection_image and collection.image != blank %}
            {% render 'image' with
              image: collection.metafields.theme.collection_banner,
              wrapper_class: 'lazyload collection__image',
              disable_style: true
            %}
          {% endif %}

          <div class="collection__image-overlay"></div>
        </header>
        {% endcomment%}

      <div class="collection__content">
        <div class="colection_header_bar-ecom">
          <header role="banner" class="collection__header {%if collection.metafields.theme.collection_banner %} collection_banner_exist {% endif %}"
            style="--text-transform: {{ section.settings.header_font_style }}; --text-color: {{ collection.metafields.theme.collection_banner_text_color.value }}; ">
          {%if collection.metafields.theme.collection_banner %} 
            <!-- image: collection.metafields.theme.collection_banner.value -->
            {% if show_collection_image and collection.metafields.theme.collection_banner != blank %}
              {% assign theme_collection_banner = collection.metafields.theme.collection_banner | image_url  %}
              {% render 'image2' with
                image: theme_collection_banner,
                wrapper_class: 'lazyload collection__image',
                disable_style: true,
                bannerTitle: collection.title
            %}
            {% endif %}
            {% if show_collection_image and collection.metafields.theme.collection_banner_mobile != blank %}
              {% assign theme_collection_banner_mobile = collection.metafields.theme.collection_banner_mobile | image_url  %}
              <div class="collection-meta-mobile-banner-wrapper">
                {% render 'image2' with
                  image: theme_collection_banner_mobile,
                  wrapper_class: 'lazyload collection__image',
                  disable_style: true,
                  bannerTitle: collection.title
                %}
              </div>
            {% endif %}
          {% endif %}
              <div class="ecom-collection-text collection__details2
                {% if show_collection_image == false or collection.image == blank %}collection__details--no-image{% endif %}
                {% if collection.metafields.theme.collection_banner == blank %} desktop-banner-unavailable {% endif %} 
                {% if collection.metafields.theme.collection_banner_mobile == blank %} mobile-banner-unavailable {% endif %} 
                "
                >
                  <!--  collection.metafields.description.collection {{ collection.metafields.description.collection }} 
                      show_description {{ show_description }}
                  -->

                  {% assign collection_subheading = "" %}

                  {% if show_description %}   
                      {% assign collection_subheading =  collection.metafields.description.collection   %}
                  {% endif %}

                  {% render 'text-block' with
                    heading_alignment: heading_alignment,
                    text_max_width: text_max_width,
                    overline: collection_label,
                    heading: collection_heading,
                  %}
                      
                  {% if collection_subheading != blank %}
                    <p class="collection-details2-desc">{{ collection_subheading | split: "<iframe" | first }}</p>
                  {% endif %}
                </div>
            </header>
        </div>
        
        
        {% if show_sort or show_filters %}
          {%- if filter_style == 'sidebar' -%}
            <div class="collection__sidebar" data-sidebar>
              {% render 'collection-sidebar' with
                categories: categories,
                filter_type: filter_type,
                show_sort: show_sort,
                show_filters: show_filters
              %}
            </div>
          {%- endif -%}
        {% endif %}

        <div class="collection__main-area">
          
          
          
         {% comment %} removed. they requested this in filter section (2025-09-12)  
          <div class="sort-option" >
            <div class="ecom_sorts sort-by--container">
              <label class="ecom_sort_label" for="sort-by">Sort by</label> 
              <select id="sort-by" class="ecom_sort_by_select sort-by">
                {% for option in collection.sort_options %}
                <option value="{{ option.value }}"{% if option.value == collection.sort_by %} selected{% endif %}>
                  {% if option.value == "created-descending"%}
                    New
                  {% elsif option.value == "best-selling" %}
                    Most Popular
                  {% elsif option.value == "price-ascending" %}
                    Lowest price
                  {% elsif option.value == "price-descending" %}
                    Rarest
                  {% else %}  
                    {{ option.name }}
                  {% endif %}
                </option>
                {% endfor %}
              </select>
            </div>
          </div>  
          {% endcomment %}
          
          <!--------------ecom end----------------------->
          {% if show_filters or show_sort %}
            {% render 'collection-filters' with
              categories: categories,
              filter_type: filter_type,
              show_sort: show_sort,
              show_filters: show_filters
            %}
          {% endif %}

        <!-- mobile sort | 2025-07-25 START -->
          <div class="ecom_sorts sort-by--container mobile-sort">
            <label class="ecom_sort_label" for="sort-by-mobile">Sort by</label> 
            <select id="sort-by-mobile" class="ecom_sort_by_select sort-by">
              {% for option in collection.sort_options %}
              <option value="{{ option.value }}"{% if option.value == collection.sort_by %} selected{% endif %}>
              {% if option.value == "created-descending"%}
                New
              {% elsif option.value == "best-selling" %}
                Most Popular
              {% elsif option.value == "price-ascending" %}
                Lowest price
              {% elsif option.value == "price-descending" %}
                Rarest
              {% else %}  
                {{ option.name }}
              {% endif %}
              </option>
              {% endfor %}
            </select>
          </div>
        <!-- mobile sort | 2025-07-25 START -->
          
          <div class="collection__window">

            <div class="collection__loading" data-loading>
              {% render 'loader' %}
            </div>

            <div id="root" class="collection__products" data-partial>
              <div class="collection__top-row {% if template == "collection.tea-makers" %}tpr-filter-container{% endif %}">
                {% render 'collection-top-bar' with
                  categories: categories
                %}

                {% if template == "collection.tea-makers" %}
                  <div class="ecom-tpr-filter" >
                    {% render 'tea-makers-filter' with categories: categories %}
                  </div>
                {% endif %}
              </div>

              <div class="grid-display w-100{{ grid_modifiers }} collection__infinite-container">

                {% for product in collection.products %}

                  {% render 'product-item' with
                    product: product,
                    swatches_enabled: show_swatches,
                    aspect_ratio: aspect_ratio
                  %}
                {% else %}
                  <div class="collection__empty">
                    <div>{{ 'collections.general.no_products' | t }}</div>
                    <a data-clear="true">{{ 'collections.filters.clear' | t }}</a>
                  </div>
                {% endfor %}
              </div>

              {% unless paginated %}
                <div class="collection__infinite-trigger">
                  {% if paginate.next %}
                    <a href="{{ paginate.next.url }}" class="bttn bttn--secondary">{{ 'general.pagination.load_more' | t }}</a>
                  {% endif %}
                </div>
              {% endunless %}

              {% if paginated %}
                <div class="mt3 w-100">
                  {% if paginate.pages > 1 %}
                    {% render 'pagination' with
                      paginate: paginate,
                      type: 'general.pagination.products'
                    %}
                  {% else %}
                    {% render 'pagination' with
                      paginate: paginate,
                      type: 'general.pagination.products',
                      display_paginate_item_count_only: true
                    %}
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  {% endpaginate %}

  {% render 'collection-flyout' with
    filter_type: filter_type,
    categories: categories,
    show_sort: show_sort
  %}
</section>
