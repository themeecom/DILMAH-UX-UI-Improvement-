            {% endcase %}
            {% endif%}
            {% endfor %}
        </div> <!-- caffeine_wrapper -->
    
    
    
        <div class="ecom_attributs grades_wrapper">
            {% for tag in product.tags %}
            {% assign dtag = tag | downcase %}
            {% if dtag contains 'grading_' %}
            {% assign tagName = dtag |replace:" ",""|replace:" ",""|replace:" ",""|replace:" ",""%}
            {% case tagName %}
            {% when 'teagrading_pekoe' %}
        
            <div class="grades_level ecom-cf-td-main">
                <div class="grades_des mini_des">
                    <p class="grades-title ecom-p-td-cf">Grades</p>
                </div>
                <div class="grades_img ecom-tea-icons">
                    <img class="grades-img" loading="lazy"
              src="https://cdn.shopify.com/s/files/1/0559/4097/2713/files/tea_grades.png?v=1622028559" alt="Dilmah Tea Grade" />
                </div>
                <div class="grades_des mini_des">
                    <p class="grades-mini-title mini-title ecom-p-td-cf">Pekoe</p>
                </div>
            </div>
            {% when 'teagrading_flowerypekoe' %}
          
            <div class="grades_level ecom-cf-td-main">
                <div class="grades_des mini_des">
                    <p class="grades-title ecom-p-td-cf">Grades</p>
                </div>
                <div class="grades_img ecom-tea-icons">
                    <img class="grades-img" loading="lazy"
              src="https://cdn.shopify.com/s/files/1/0559/4097/2713/files/tea_grades.png?v=1622028559" alt="Dilmah Tea Grade" />
                </div>
                <div class="grades_des mini_des">
                    <p class="grades-mini-title mini-title ecom-p-td-cf">Flowerypekoe</p>
                </div>
            </div>
