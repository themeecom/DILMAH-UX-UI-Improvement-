  <div class="product__media" id="product_img_canva" style="display:none">
    {% if product.media.size > 0 %}
      {%- for media in product.media -%}
        <div class="product__media-wrapper" data-media-id="{{ media.id }}">
          {% render 'media', media: media, featured_media: featured_media, loop:forloop.index %}
        </div>
