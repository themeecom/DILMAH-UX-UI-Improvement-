      <div class="additional-attributes-wrapper table-wrapper">
        <div class="ecom_attributs format_wrapper">
            <p class="format-title ecom-p-td-cf">Tea Format</p>
            {% for tag in product.tags %}
         
            {% assign dtag = tag | downcase %}
            {% if dtag contains 'format_' %}
            {% assign tagName = dtag |replace:" ",""|replace:" ",""|replace:" ",""|replace:" ",""%}
        
            {% case tagName %}
            {% when 'teaformat_looseleaftea' %}
          
            <div class="format-looseleaf ecom-cf-td-main">
                
                <div class="format_img ecom-tea-icons">
                    <img loading="lazy"
              class="format-img" src="https://cdn.shopify.com/s/files/1/0525/3693/4552/files/loose_leaf_tea_eca49ace-03c3-43d2-99a8-77190269c2ce.jpg?v=1633238616" alt="Dilmah Loose Leaf" />
                </div>
                <div class="format_des mini_des">
                    <p class="format-mini-title mini-title ecom-p-td-cf">Loose Leaf</p>
                </div>
            </div>
            {% when 'teaformat_individuallyfoilwrappedteabags' %}
          
            <div class="format_level ecom-cf-td-main">
                
                <div class="format_img ecom-tea-icons">
                    <img class="format-img" loading="lazy"
              src="https://cdn.shopify.com/s/files/1/0558/2920/1082/files/foil_wrap_bags.png?v=1755081759" alt="Dilmah Individually Foil Wrapped" />
                </div>
                <div class="format_des mini_des">
                    <p class="format-mini-title mini-title ecom-p-td-cf">Individually Foil Wrapped</p>
                </div>
            </div>
            {% when 'teaformat_sachets' %}
          
            <div class="format_level ecom-cf-td-main">
               
                <div class="format_img ecom-tea-icons">
                    <img class="format-img" loading="lazy"
                      src="https://cdn.shopify.com/s/files/1/0525/3693/4552/files/tea_sachet_1cdd2632-56cf-438a-a3dd-d8414e2f8894.png?v=1633238616" alt="Dilmah Sachets"  />
                </div>
                <div class="format_des mini_des">
                    <p class="format-mini-title mini-title ecom-p-td-cf">Sachets</p>
                </div>
            </div>
            {% when 'teaformat_teacupbags' %}
           
            <div class="format_level ecom-cf-td-main">
                
                <div class="format_img ecom-tea-icons">
                    <img class="format-img" loading="lazy"
                      src="https://cdn.shopify.com/s/files/1/0558/2920/1082/files/String_tea_bags-_cup_bags.png?v=1755081759" alt="Dilmah Tea Bag" />
                </div>
                <div class="format_des mini_des">
                    <p class="format-mini-title mini-title ecom-p-td-cf">Teabags</p>
                </div>
            </div>
            {% else %}
           >
            {% endcase %}
            {% endif%}
            {% endfor %}
        </div> <!-- format_wrapper -->
    
    
    
        <div class="ecom_attributs caffeine_wrapper">
