{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign enable_image_zoom = section.settings.enable_image_zoom -%}
{%- assign compare_at_price = current_variant.compare_at_price -%}
{%- assign price = current_variant.price -%}
{%- assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
{%- assign first_3d_model = product.media | where: "media_type", "model" | first -%}

{% assign show_price_comparison = false %}

<input type="hidden" id="ecom-tags" values="{{ product.tags | join:"," }}">
{% assign comingSoon = false %}
{% assign preorder = false %}

{% for tag in product.tags %}

{% if tag contains "pre-order" %}
  {% assign preorder = true %}
{% endif %}

{% if tag contains "coming-soon" %}
  {% assign comingSoon = true %}
{% endif %}
  
{% if tag contains 'Unique' %}
{% assign Unique = tag | split: "_"| last  %}  
{% endif %}

{% if tag contains 'Tea Type' %}
{% assign Tea-Type = tag | split: "_"| last  %}  
{% endif %}

{% if tag contains 'accompaniment pairings' %}
{% assign Accompaniment-Pairings = tag | split: "_"| last  %}  
{% endif %}

{% if tag contains 'Caffeine Level' %}
{% assign Caffeine-Level = tag | split: "_"| last  %}  
{% endif %}

{% if tag contains 'number of tea bags' %}
{% assign Number-of-Tea-Bags = tag | split: "-"| last  %}  
{% endif %}

{% if tag contains 'Material' %}
{% assign Material = tag | split: "_"| last  %}  
{% endif %}

{% if tag contains 'price' %}
{% assign Price = tag | split: "_"| last  %}  
{% endif %}

{% if tag contains 'Time Of Day' %}
{% assign Time-of-Day = tag | split: "_"| last  %}  
{% endif %}

{% if tag contains 'Tea Format' %}
{% assign Tea-Format = tag | split: "_"| last  %}  
{% endif %}

{% if tag contains 'servings' %}
{% assign Servings = tag | split: "-"| last  %}  
{% endif %}

{% if tag contains 'Colour' %}
{% assign Colour = tag | split: "_"| last  %}  
{% endif %}

{% if tag contains 'gift card' %}
{% assign Gift-Card = tag | split: "_"| last  %}  
{% endif %}

{% if tag contains 'Tea Flavour' %}
{% assign Tea-Flavour = tag | split: "_"| last  %}  
{% endif %}

{% if tag contains 'Tea Strength' %}
{% assign Tea-Strength = tag | split: "_"| last  %}  
{% endif %}

{% if tag contains 'Tea format' %}
{% assign Tea-Format = tag | split: "_"| last  %}  
{% endif %}

{% if tag contains 'Category' %}
{% assign Category = tag | split: "_"| last  %}  
{% endif %}

{% if tag contains 'Tea Grading' %}
{% assign Tea-Grading = tag | split: "_"| last  %}  
{% endif %}

{% if tag contains 'Mood' %}
{% assign Mood = tag | split: "_"| last  %}  
{% endif %}

{% if tag contains 'grams' %}
{% assign grams = tag | split: "-"| last  %}  
{% endif %}

{% if tag contains 'accompaniment pairings-' %}


{%assign tags = tag | split: "-"| last%}

{% assign accomp = accomp |append : ", " | append: tags    %}

{% endif %}
{% endfor %}


{% if current_variant.compare_at_price > current_variant.price %}
  {% assign show_price_comparison = true %}
{% endif %}

{% assign accomp = accomp | remove_first: "," %}


<style>
  {{ section.settings.title_font_picker | font_face }}
  .product__title {
    font-family:  {{ section.settings.title_font_picker.family }};
    font-style: {{ section.settings.title_font_picker.style }};
    font-weight: {{ section.settings.title_font_picker.weight }};
    font-size: {{ section.settings.title_font_size_desktop }}px;
  }
  @media only screen and (max-width: 768px) {
    .product__title {
      font-size: {{ section.settings.title_font_size_mobile }}px;
    }
  }
</style>

{% capture product_heading %}
  {% if show_vendor %}
    <p class="product__vendor overline mt0">{{ product.vendor | link_to_vendor }}</p>
  {% endif %}

  {% if product.available %}
    <span class="instock_ale">IN STOCK</span>
  {% endif %}

  
  <h1 class="product__title type-heading-display mt0 mb1" data-preorder="{{ preorder }}" data-comingsoon="{{ comingSoon }}">
    {% if preorder == true %}
     <span class="preorder"> PRE-ORDER </span>
    {% endif %}
  {{ product.title }}
  </h1>

  {% if product.tags contains "on_auction" %}
        <div class="product__description mt5 rte" style="margin-top: 0px;">
          {{ product.description }}
  {% endif %}
  
<!-- added on 9/25/2021 -->
  <!-- added on 9/25/2021 -->
  {% unless product.tags contains "on_auction" %}
  <!-- yotpo review  START -->
<div class="ecom-yotpo-title-review-wrap">
  <div class="yotpo-widget-instance" data-yotpo-instance-id="824555" data-yotpo-product-id="{{product.id}}" data-yotpo-cart-product-id="{{item.product.id}}" 
    data-yotpo-section-id="{{template.name}}"></div>
</div>
<!-- yotpo review END -->
    {% endunless %}


  <!-------------------------------------------------------------------------------->
  {% if product.metafields.product.shortDES %}

     <p class="short_des_ecom"> {{ product.metafields.product.shortDES }}</p>

 {% endif %}
    <!-----------------------------------------------ecom  new add------------------>

<div class="product-info-bag">
  
   {% if Number-of-Tea-Bags %}
   <p class="product-info-bag-pr"><span class="icon-ecom-bag ic-pro-info"></span> {{Number-of-Tea-Bags}} bags per pack</p>  
  {% endif %}
    {% if Servings %}
   <p class="product-info-bag-pr"><span class="icon-ecom-cup ic-pro-info"></span> {{Servings}} servings per pack</p>  
  {% endif %}
{% if grams %}
    <p class="product-info-bag-pr"><span class="icon-ecom-grams ic-pro-info"></span> {{grams}} grams per pack </p>

  {% endif %}                
                </div>
   <!--------------------------->

  
{% unless product.tags contains "on_auction" %}
  
  <div class="product__price" style="display: none !important;">
    <s data-compare-price class="mr1 meta{% if show_price_comparison == false %} hide{% endif %}">
      {% if show_price_comparison %}
        {{ current_variant.compare_at_price | money }}
      {% endif %}
      <span class="visually-hidden" data-compare-text>{{ 'products.product.regular_price' | t }}</span>
    </s>
    <span data-product-price class="product-price-m ecom_pro_price" data-price="{{ current_variant.price }}">{{ current_variant.price | money }}</span>
    <!--   added on 10/2/2021 tax included   -->
    {%- if shop.taxes_included or shop.shipping_policy.body != blank -%}
    <span class="product__policies rte type-body-small tc mb0" data-product-policies>
      {%- if shop.taxes_included -%}
      {{ 'products.product.include_taxes' | t }}
      {%- endif -%}
      {%- if shop.shipping_policy.body != blank -%}
      {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
      {%- endif -%}
    </span>
    {%- endif -%}
    <!--   added on 10/2/2021 tax included | END   -->
    <!--   added on 10/2/2021 product availability   -->
    {% comment %}
    {% if product.available %}
    <span class="instock_ale">IN STOCK</span>
    {% endif %}
    {% endcomment %}
    <!--   added on 10/2/2021 tax included | END   -->
    {% render 'unit-price' item: current_variant %}
  </div>
  
  {% if comingSoon %}
    <div class="cart_button">
      <button type="submit" name="add" data-commingsoon="true" aria-disabled="true" aria-label="Sold out" class="bttn product-form__cart-submit mt2 bttn--secondary" data-lang-available="Add to cart" data-lang-unavailable="Unavailable" data-lang-sold-out="Sold out" data-add-to-cart="" disabled="disabled">
        Coming Soon
      </button>
    </div>
  {% endif %}
{% endunless %}
  
  <div class="product__reviews hidden mb3">
    <span class="product__reviews-stars hidden"></span>
    <a href="#" class="product__reviews-trigger accent"></a>
  </div>

  {% if product.metafields.custom.pdf_upload.value %}
    <a class="sampleDownloadPDF" href="{{ product.metafields.custom.pdf_upload.value.url }}">
      <i class="fa fa-angle-double-right" aria-hidden="true"></i> Preview the Sample Pages of the Book
    </a>
  {% endif %}

{% endcapture %}
