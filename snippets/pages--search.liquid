{% paginate search.results by 10 %}

<div class="search-template">

  <div class="search-template__heading">
    <h1 class="type-heading-display mt0 mb5">
      {% if search.performed %}
        <span class="visually-hidden">{{ 'search.heading' | t: count: search.results_count }}:</span>
          {{ 'search.results_with_count' | t: terms: search.terms, count: search.results_count }}
      {% else %}
        {{ 'search.title' | t }}
      {% endif %}
    </h1>

    <form action="{{ routes.search_url }}" method="get" role="search">
      <label for="Search" class="visually-hidden">
        {{ 'search.placeholder' | t }}
      </label>
      <input type="search"
            name="q"
            id="Search"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'search.placeholder' | t }}"
      >
      <button
        type="submit"
        class="search-template__submit-button bttn"
      >
        {{ 'search.submit' | t }}
      </button>
    </form>
  </div>

  {% if search.performed %}
    {% if search.results_count == 0 %}
      <p class="search-template__no-results">{{ 'search.no_results_html' | t: terms: search.terms }}</p>
    {% else %}
      <h2 class="visually-hidden">{{ 'search.heading' | t: count: search.results_count }}</h2>
      <ul class="search-template__results">
        {% for item in search.results %}
          <li class="search-template__item">
            <div class="search-template__image">
              {%if item.tags contains "buy-more-save-more" %}
                <img src="https://cdn.shopify.com/s/files/1/0558/2920/1082/files/label-buy-more-save-more.png" class="buy-more-save-more">
              {% endif %} 
              <a href="{{ item.url | within: collection }}">
                {% assign featured_media = item.featured_media.preview_image | default: item.featured_image %}
                {% if item.object_type == 'product' %}
                  {% if featured_media != blank %}
                    {% comment %} {{ featured_media | img_url: '240x240' | img_tag }} {% endcomment %}
                    <img class="searched-product-image"
                      srcset="{%- if featured_media.width >= 165 -%}{{ featured_media | image_url: width: 165 }} 165w,{%- endif -%}

                      {%- if featured_media.width >= 360 -%}{{ featured_media | image_url: width: 360 }} 360w,{%- endif -%}
                  
                      {%- if featured_media.width >= 533 -%}{{ featured_media | image_url: width: 533 }} 533w,{%- endif -%}
                  
                      {%- if featured_media.width >= 720 -%}{{ featured_media | image_url: width: 720 }} 720w,{%- endif -%}
                  
                      {%- if featured_media.width >= 940 -%}{{ featured_media | image_url: width: 940 }} 940w,{%- endif -%}
                  
                      {%- if featured_media.width >= 1066 -%}{{ featured_media | image_url: width: 1066 }} 1066w,{%- endif -%}
                  
                      {{ featured_media | image_url }} {{ featured_media.width }}w"
                      
                      src="{{ featured_media | img_url: width:533 }}"
                  
                      sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                  
                      loading="lazy"
                  
                      width="{{ featured_media.width }}"
                    
                      height="{{ featured_media.height }}"
                      
                      alt="{{ featured_media.alt | escape }}"
                    >
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {% endif %}
                {% else %}
                  {% assign featured_media = item.image %}
                  {% if featured_media %}
                    {% comment %} {{ featured_media | img_url: '240x240' | img_tag }} {% endcomment %}
                    <img class="searched-product-image"
                      srcset="{%- if featured_media.width >= 165 -%}{{ featured_media | image_url: width: 165 }} 165w,{%- endif -%}

                      {%- if featured_media.width >= 360 -%}{{ featured_media | image_url: width: 360 }} 360w,{%- endif -%}
                  
                      {%- if featured_media.width >= 533 -%}{{ featured_media | image_url: width: 533 }} 533w,{%- endif -%}
                  
                      {%- if featured_media.width >= 720 -%}{{ featured_media | image_url: width: 720 }} 720w,{%- endif -%}
                  
                      {%- if featured_media.width >= 940 -%}{{ featured_media | image_url: width: 940 }} 940w,{%- endif -%}
                  
                      {%- if featured_media.width >= 1066 -%}{{ featured_media | image_url: width: 1066 }} 1066w,{%- endif -%}
                  
                      {{ featured_media | image_url }} {{ featured_media.width }}w"
                      
                      src="{{ featured_media | img_url: width:533 }}"
                  
                      sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                  
                      {% unless lazy_load == false %}loading="lazy"{% endunless %}
                  
                      width="{{ featured_media.width }}"
                    
                      height="{{ featured_media.height }}"
                      
                      alt="{{ featured_media.alt | escape }}"
                    >
                  {% else %}
                   {% comment %} {% render 'icon-article-placeholder' %}  {% endcomment %}
                  {% endif %}
                {% endif %}
              </a>
            </div>
            {% if item.object_type == 'product' %}
              <div>
                <h3 class="type-heading-2 mb2">
                  <a href="{{ item.url | within: collection }}">
                    {{ item.title }}
                  </a>
                </h3>
                <!-- yotpo review  START -->
                <div class="ecom-yotpo-title-review-wrap"> <div class="yotpo bottomLine" data-product-id="{{ item.id }}"> </div> </div>
                <!-- yotpo review END -->
                {% if item.compare_at_price > item.price %}
                  {% if item.price_varies %}
                    {% assign sale_price = item.price | money %}
                    {{ 'products.product.on_sale_from_html' | t: price: sale_price }}
                  {% else %}
                    {{ 'products.product.on_sale' | t }}
                    <span data-3>{{ item.price | money }}</span>
                  {% endif %}
                  <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
                  <s>{{ item.compare_at_price | money }}</s>
                {% else %}
                  {% if item.price_varies %}
                    {% assign price = item.price | money %}
                    <span data-1>{{ 'products.product.from_text_html' | t: price: price }}</span>
                  {% else %}
                    <span data-2>{{ item.price | money }}</span>
                  {% endif %}
                {% endif %}
                {% unless item.available %}
                {{ 'products.product.sold_out' | t }}
                {% endunless %}
                
                
                               <div class="cart_row2">  
    {% if item.available %}
    <button class="addtocart_btn product_btn ecom" data-variant="{{ item.variants.first.id }}"><span style="display:none" class="loading_{{ item.variants.first.id }}"><img src="https://cdn.shopify.com/s/files/1/0525/3693/4552/files/loading-gif-png-5.gif?v=1615441250" style="width: 35px;"></span>Add to cart</button>
    
    {% endif %} 
     {% unless item.available %}
      <button class="addtocart_btn_sold product_btn ecom" data-variant="{{ item.variants.first.id }}"><span style="display:none" class="loading_{{ item.variants.first.id }}"><img src="https://cdn.shopify.com/s/files/1/0525/3693/4552/files/loading-gif-png-5.gif?v=1615441250" style="width: 35px;"></span>Add to cart</button>
    
    {% endunless %}
   
    </div> 
                
                
              </div>
            {% else %}
              <div>
                <h3 class="type-heading-2 mb2">
                  <a href="{{ item.url | within: collection }}">
                    {{ item.title }}
                  </a>
                </h3>
                <p class="type-body-regular">{{ item.content | strip_html | truncatewords: 50 }}</p>
              </div>
            {% endif %}

          </li>
        {% endfor %}
      </ul>

      {% if paginate.pages > 1 %}
        <div class="search-template__pagination">
          <hr class="mt0 mb3 b--solid b--default bb" style="border-top: none;" />
          {% render 'pagination' with
            type: 'general.pagination.products',
            paginate: paginate
          %}
        </div>
      {% endif %}
    {% endif %}
  {% endif %}
</div>
{% endpaginate %}
