{% assign preorder = false %}
{% assign comingSoon = false %}
{% for tag in product.tags %}
  {% assign dtag = tag | downcase %}
  {% if dtag contains "pre-order" %}
    {% assign preorder = true %}
  {% endif %}
  {% if dtag contains "coming-soon" %}
    {% assign comingSoon = true %}
  {% endif %}
{% endfor %}

{% assign quick_shop_enabled = false %}

{% if settings.cart_quick_shop_enabled and product.available %}
  {% assign quick_shop_enabled = true %}
{% endif %}

{% assign includes_aspect_ratio = false %}

{% if aspect_ratio != blank and aspect_ratio != 'natural' %}
  {% assign includes_aspect_ratio = true %}
{% endif %}

<div class="product-item{% if includes_aspect_ratio %} product-item--{{ aspect_ratio }}{% endif %}" data-product-tags="{{ product.tags | join: "," | downcase }}">
  {% if product.featured_media != blank or product.media.size > 1 %}

    <a href="{{ product.url | within: collection }}" class="ecom_cart_a product-item__image-wrapper db{% unless product.available %} o-50{% endunless %}">

      {% if quick_shop_enabled %}
      
      {% comment %}
      <button type="button" class="product-item__quick-shop-button active bttn">
          <span>{{ 'products.product.add_to_quick_shop' | t }}</span>
        </button>
      {% endcomment %}
      
      
      
    
      
      {% endif %}

      {% if product.media.size > 1 %}
        <div class="product-item__images">
          {%if product.tags contains "buy-more-save-more" %}
            <img src="https://cdn.shopify.com/s/files/1/0558/2920/1082/files/label-buy-more-save-more.png" class="buy-more-save-more">
          {% endif %} 
          {% comment %} used for size {% endcomment %}
          <div class="product-item__sizer">
            {% render 'image' with
              image: product.media[0].preview_image,
              id: product.media[0].id,
              disable_style: includes_aspect_ratio,
              productTitle:product.title
            %}
          </div>
          <div class="product-item__image first">
            {% render 'image' with
              image: product.media[0].preview_image,
              id: product.media[0].id,
              disable_style: includes_aspect_ratio,
              productTitle:product.title
            %}
          </div>
          <div class="product-item__image not-first">
            {% render 'image' with
              image: product.media[1].preview_image,
              id: product.media[1].id,
              disable_style: includes_aspect_ratio,
              productTitle:product.title
            %}
          </div>
        </div>
      {% else %}
        <div class="product-item__image">
          {%if product.tags contains "buy-more-save-more" %}
            <img src="https://cdn.shopify.com/s/files/1/0558/2920/1082/files/label-buy-more-save-more.png" class="buy-more-save-more">
          {% endif %}
          {% render 'image' with
            image: product.featured_media.preview_image,
            id: product.featured_media.id,
            disable_style: includes_aspect_ratio,
            productTitle:product.title
          %}
        </div>
      {% endif %}
    </a>

    {% if quick_shop_enabled %}
      <div class="quick-shop">
        {% render 'quick-shop-product-form' with product: product %}
      </div>
    {% endif %}

    {% comment %} SALE BADGE {% endcomment %}
    {% if product.compare_at_price > product.price %}
      {% if product.has_only_default_variant %} {% comment %} only show when there is only one variant {% endcomment %}
        <div class="badge type-body-small ttu lh-title absolute top-0 right-0 bg-sale same-as-bg" ecom-bb>
          {{ product.compare_at_price_max | minus: product.price | times: 100.0 | divided_by: product.compare_at_price_max | round }}% off
        </div>
      {% endif %}
    {% endif %}
  

    {% comment %} SOLD OUT BADGE {% endcomment %}
    {% unless product.available %}
          <div class="badge type-body-small ttu lh-title absolute top-0 right-0 mt3 mr3 bg-sold-out same-as-bg {% if comingSoon %} comingSoon {% endif %}" >
            {% if comingSoon %}
              Coming Soon
            {% else %}
              {% comment %}{{ 'products.product.sold_out' | t }} {% endcomment %}
              Notify Me
            {% endif %}
          </div>
    {% endunless %}

  {% else %}
    <div class="product-item__image-wrapper mb3{% unless product.available %} o-50{% endunless %}">
      <div class="product-item__image">
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    </div>
  {% endif %}

  <div class="product-item__details-wrapper relative">
    {% comment %} PRODUCT SWATCHES {% endcomment %}
    {% if swatches_enabled %}
      {% for option in product.options_with_values %}
        {%- assign file_extension = 'png' -%}
        {%- assign opt = option.name | downcase -%}
        {%- assign opt_setting = settings.swatch_option | downcase -%}

        {% if opt == opt_setting %}
          <a href="{{ product.url }}" class="product-item__swatches-wrapper absolute">
            <p class="product-item__swatch-heading mt0 mb1">
              {{ 'collections.general.swatch_heading' | t: option_name: option.name | append: 's' }}
            </p>
            <div class="product-item__swatches">
              {% for color in option.values %}
                <div
                  class="product-item__swatch"
                  style="background-image: url({{ color | handle | append: '.' | append: file_extension | file_url }})"
                ></div>
              {% endfor %}
            </div>
          </a>
        {% endif %}
      {% endfor %}
    {% endif %}


    <div class="product-item__details">
      <a href="{{ product.url }}" data-preorder="{{ preorder }}">
         {% if preorder == true %}
           <span class="preorder"> PRE-ORDER </span>
          {% endif %}
        {{ product.title }}
      </a>

      <!-- yotpo review  START -->
      <div class="ecom-yotpo-title-review-wrap"> <div class="yotpo bottomLine" data-product-id="{{ product.id }}"> </div> </div>
      <!-- yotpo review END -->

      {% render 'product-item-price' with product: product %}
    </div>
 
  <div class="cart_row" >  
    {% if product.available %}
      <button class="addtocart_btn product_btn ecom ecom_addToCart" data-variant="{{ product.variants.first.id }}" {% if comingSoon %} style="display: none;" {% endif %}>
        <span style="display:none" class="loading_{{ product.variants.first.id }}">
          <img src="https://cdn.shopify.com/s/files/1/0525/3693/4552/files/loading-gif-png-5_35x.gif?v=1615441250" style="width: 35px;">
        </span>Add to cart
      </button>
      
      {% endif %} 
       {% unless product.available %}
        <button class="addtocart_btn_sold product_btn ecom ecom_soldOut" data-variant="{{ product.variants.first.id }}" {% if comingSoon %} style="display: none;" {% endif %}>
          <span style="display:none" class="loading_{{ product.variants.first.id }}">
            <img src="https://cdn.shopify.com/s/files/1/0525/3693/4552/files/loading-gif-png-5_35x.gif?v=1615441250" style="width: 35px;">
          </span>Add to cart
        </button>
      {% endunless %}
      {% if comingSoon %}
        <button class="addtocart_btn_sold product_btn ecom ecom_soldOut" data-variant="{{ product.variants.first.id }}" disabled>
          <span style="display:none" class="loading_{{ product.variants.first.id }}">
            <img src="https://cdn.shopify.com/s/files/1/0525/3693/4552/files/loading-gif-png-5_35x.gif?v=1615441250" style="width: 35px;">
          </span> Coming Soon
        </button>
      {% endif %}
    
    
    <a class="ecom_quickView Quickview-btn product_btn"  href="{{ product.url | within: collection }}">View Product</a>
    </div>   
    
  </div>
  
 
 
  
</div>

<style>
  

  
  /*  added on 12/31/2021  */
  a.ecom_quickView.Quickview-btn.product_btn {
    border: 1px solid black;
    border-radius: 25px;
    padding: 8px 16px;
    min-height: auto;
    margin-top: 10px;
    font-size: 11px;
    font-weight: 600;
    line-height: 2;
    letter-spacing: 1px;
  }
 @media only screen and (max-width: 760px) {
    a.ecom_quickView.Quickview-btn.product_btn {
      margin-top: 5px;
      font-size: 10px !important;
    }
  } 
  @media (max-width: 320px) {
    a.ecom_quickView.Quickview-btn.product_btn {
      padding: 6px;
      letter-spacing: 0;
    }
  }
  
  
  .ecom_addToCart,
  a.ecom_quickView{
    width: 65%;
    padding: 0 !important;
    height: auto !important;
    line-height: 3.5 !important;
    font-size: 12px !important;
    text-align: center;
  }
  
  @media (max-width: 1100px) {
    .ecom_addToCart,
    a.ecom_quickView{
      width: 75%;
      max-width: unset !important;
    }
  }
  
  @media (max-width: 607px) {
    .ecom_addToCart,
    a.ecom_quickView{
      width: 55%;
      max-width: unset !important;
    }
  }
  
</style>
