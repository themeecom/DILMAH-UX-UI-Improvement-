{% assign modifiers = '' %}

{% assign modifiers = modifiers | append: ' section--' | append: section_style %}

{% unless section_style == 'contrast' %}
  {% assign modifiers = modifiers | append: ' section--bordered' %}
{% endunless %}
{% liquid
  assign time_in_ms = timer | times: 1000
  assign show_nav_dots = true

  if slides.size < 3
    assign show_nav_dots = false
  endif
%}

<section
  data-section-id="{{ id }}"
  data-section-type="collage"
  data-animation-enabled="{{ enable_animation }}"
  class="section {{ modifiers }} {{ section.settings.custom_class }}"
>

  {% render 'text-block' with
    id: id,
    modifiers: 'mb5 animation__staggered-children-fade-in',
    heading_alignment: heading_alignment,
    text_max_width: text_max_width,
    overline: overline,
    heading: heading,
    subheading: subheading
  %}

<div class="collage" style="display:none">
    
        
     <div id="slider2bjj" class="flexslider ecom-baner-slide" >
       
       <section class="regular slider">
    {% for block in blocks %}
    
   
{% if block.type == 'slide' %}
    
  {% assign s = block.settings %}
      {%- assign image = block.value | default: s.image  -%}

      {% assign parent_block_is_link = false %}

              <div>
  
                 <a href="{{s.link}}">
               
             
                   {% comment %}  
                   <img src="{{ s.image | img_url: '700x' }}" style="width: 100%;">
                   {% endcomment %} 
                     <div
              data-bgset="{% render 'responsive-bg-image', image: image %}"
              role="img"
              aria-label="{{ image.alt }}"
              class="collage__item-inner "
              {% unless s.image == blank %}
                style="background-image: url({{ s.image | img_url: '700x' }});"
              {% endunless %}
                          ></div>
                   
                </a>
         </div>
            
    
    {% endif %}
    {% endfor %}
    </section>
        </div>
    {% for block in blocks %}
    
   
{% if block.type == 'grid_item' %}
    
    {% assign s = block.settings %}
      {%- assign image = block.value | default: s.image  -%}

      {% assign parent_block_is_link = false %}

      {% if s.link != blank and s.link_text == blank %}
        {% assign parent_block_is_link = true %}
        <a href="{{ s.link }}" class="test collage__item animates collage__item--{{ s.size }} ecom-slide-{{ forloop.index0 }}" {{ block.shopify_attributes }} data-index="{{ forloop.index0 }}">
      {% else %}
        <div
          class="collage__item animates collage__item--{{ s.size }}{% if s.image == blank %} collage__item--has-placeholder{% endif %}  ecom-slide-{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
          data-index="{{ forloop.index0 }}"
        >
      {% endif %}

          <div class="collage__item-inner-wrapper1 test" >
  {%- assign video2 = block.value | default: s.vlink  -%} 
 
            <div
              data-bgset="{% render 'responsive-bg-image', image: image %}"
              role="img"
              aria-label="{{ image.alt }}"
              class="collage__item-inner {% if video2 %} collageTopRightPics {% endif %}"
              id="banner-top-pic-{{ forloop.index }}"
              {% unless s.image == blank %}
                style="background-image: url({{ s.image | img_url: '700x' }});"
              {% endunless %}
            >

              {% if video2 %}
                <video class="christmas-fullscreen-video collage__item-inner" style="display:none;" id="christmasVideo" autoplay="autoplay" muted loop>
                  <source src="{{ video2 }}">
                </video>
                
                 <script>
                  window.addEventListener("load", function(){
                    document.body.addEventListener("touchstart", playVideo);
                    const bannerPic1 = document.getElementById(`banner-top-pic-2`);

                    {% unless s.image != blank %}
                      bannerPic1.style.backgroundImage = "none";
                    {% endunless %}
                    bannerPic1.style.padding = "0";
                    function playVideo() {
                        const video = document.getElementById('christmasVideo');
                        video.style.display = "block";
                        if(video.playing) {
                        } else {
                            video.play();
                        }
                      
                    }
                    playVideo()
                
                    });

                    window.addEventListener("DOMContentLoaded", function(e) {
                        if(mobileCheck()) {
                            document.querySelector(`#christmasVideo`)?.remove();
                        }
                    })
                  </script>
                
              {% endif %}
  
              {% unless s.video_url == blank %}
                <video class="collage__video" autoplay playsinline loop muted src="{{ s.video_url }}" />
              {% endunless %}

              {% if s.image == blank and s.video_url == blank %}
                <div class="collage__placeholder">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
              {% endif %}
            </div>

            {% if s.overline != blank or s.heading != blank or s.subheading != blank or s.link_text != blank %}
              {% render 'overlay' with
                section_id: id,
                id: block.id
                overlay_opacity: s.overlay_opacity,
                overlay_color: s.overlay_color,

                text_container_color: text_container_color,
                alignment: s.alignment,
                overline: s.overline,
                heading: s.heading,
                subheading: s.subheading,
                text_color: text_color,
                text_max_width: s.text_max_width,


                parent_block_is_link: parent_block_is_link,
                link: s.link,
                link_label: s.link_text,
                link_text_color: button_text_color
                link_border_color: button_border_color
              %}
            {% endif %}
          </div>

        {% render 'text-block',
          id: id,
          modifiers: 'mb3 mt3',
          heading_alignment: 'left',
          text_max_width: text_max_width,
          overline: s.overline,
          heading: s.heading,
          subheading: s.subheading,
          link: s.link,
          link_text: s.link_text,
        %}

      {% if s.link != blank and s.link_text == blank %}
        </a>
      {% else %}
          
          
           
          
        </div>
      {% endif %}
    {% endif %}
    {% endfor %}

  </div>
</section>


<style>
.collageTopRightPics{
background-image: none;
    padding: 0px;
    width: 100%;
    position: relative;
    height: 14vw;
}

.christmas-fullscreen-video{
display: block;
    object-fit: contain;
    width: 100%;
    height:13.8vw;
    position: absolute;
    left:-6px;
    right: 0;
    top: 0px;
    bottom: 0;
    padding: 0;
    margin: 0;
}
  
  ol.flex-control-nav.flex-control-paging {
    display: none;
}
  ul.slides {
    width: 1200%;
    transition-duration: 0.6s;
    transform: translate3d(-1509px, 0px, 0px);
}
  
  .slick-next {
    right: 10px;
}
 .slick-prev {
    left: 15px;
   z-index: 99;
} 
  
  div#slider2bjj {
    margin: 0 !important;
    border: 0;
}
  .collage__item.animates.ecom-slide-3 .collage__item-inner {
    background-position: bottom !important;
} 
  
  .header__content {
    box-shadow: unset;
} 

/* @media only screen and (min-width:1700px){
  .collageTopRightPics{
    height:13.98vw !important;
  }
} */
#banner-top-pic-3 , #banner-top-pic-2 {
  height:13.7vw;
  padding:0!important;
}
  #banner-top-pic-1{
    display:none;
  }
  </style>

<script>
  window.addEventListener("load", function(){
    document.getElementById('banner-top-pic-1').style.display="none";
  });
</script>


 