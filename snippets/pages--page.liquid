<section
  class="page section faq_page"
  data-section-id="{{ id }}"
  data-section-type="page"
>
  <header class="page__header center">
    {% unless overline == blank %}
      <div class="page__overline overline ma0 mb3 tc">
        {{ overline }}
      </div>
    {% endunless %}

    <h1 class="type-heading-1 tc mt0 mb5">{{ page.title }}</h1>
  </header>

  {%- if blocks.size > 0 -%}
    <div class="about__grid about__grid--{{ blocks.size }}">
      {%- for block in section.blocks -%}
        <div class="about__block about__block--{{ forloop.index }}">

          {%- if block.settings.image == blank and block.settings.video_url == blank -%}
            <div class="placeholder-image">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}

          {%- if block.settings.image != blank -%}
            {% render 'image' with
              image: block.settings.image,
              disable_style: true
            %}
          {%- endif -%}

          {% if block.settings.video_url != blank %}
            <video class="about__block-video" autoplay playsinline loop muted src="{{ block.settings.video_url }}"></video>
          {% endif %}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="page__content center">
    <div class="rte">
      {{ page.content }}
    </div>
  </div>
</section>
    <style>

    .tc_text {
        margin-left: 35%;
        margin-right: 6%;
    }

    .tc_wrapper {
        position: relative;
    }

    .tc_button {
        position: absolute;
        right: 8%;
        bottom: 0px;
        top: 300px;
    }
.tc_button a {
        text-decoration: none;
    }
    .tc_button a span {
        text-decoration: none;
        font-size: 1.2em;
        font-weight: 600;
        color:  #017d85;
    }
    .tc_button a span:hover {
        color: #015358;
    }

    .tc_button a:visited {
        color: black;
    }
 
    @media only screen and (max-width: 768px) {
      .purpose_block div[class*="card"][class*="_"][class*="text"] {
          width: 130px;
          margin-left: -38%;
          padding-left: 5px;
          padding-right: 5px;
      }

      .purpose_block div[class*="card"][class*="_"][class*="text"] p {
          margin-top: 0;
          margin-bottom: 0;
          position: relative;
          transform: translate(-50%, -50%);
          left: 50%;
          top: 50%;
      }   
    }
      @media only screen and (max-width: 1024px) {
        .tc_text {
          margin-left: 50%;
          margin-right: 6%;
        }
      }

    @media only screen and (max-width: 425px) {
        .tc_text {
            margin-left: 1%;
            margin-right: 1%;
        }
        .tc_button {
        	position: initial;
        	padding-top: 20px;
        }
    }
    </style>

{% if template == "page.about-us" %}
<script>
  document.addEventListener("DOMContentLoaded", ()=>{
    document.querySelectorAll(`.purpose_block p span`).forEach(elem=> elem.innerHTML = elem.innerHTML.replaceAll("&nbsp;", " "));
  });
</script>
{% endif %}