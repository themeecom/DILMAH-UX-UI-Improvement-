let currentTop = -12;
$(window).scroll(function(e){ 
    
  var $el = $('.side-list '); 
    
  var isPositionFixed = ($el.css('position') == 'fixed');

  if ($(this).scrollTop() > 54 ){ 
    $el.css({ 'top': '-64px'}); 
      currentTop -64;
  }
    
  if ($(this).scrollTop() < 54 && $(this).scrollTop() >0 ){
    $el.css({'top': currentTop + "px"}); 
      currentTop -=1.9;
  } 

  if($(this).scrollTop() <10) {
      console.log("inside min 10", $(this).scrollTop());
      $el.css({"top": "-12px"})
      currentTop = -12;
  }
    
});
</script>