          {% endif %}

          {% unless block.settings.description == blank %}
            <div
              class="gallery__description type-body-regular mt3 mb0"
              data-theme-editor-setting="section.{{ id }}.block.{{ block.id }}.description"
            >
              {{ block.settings.description }}
            </div>
          {% endunless %}
        </div>
      {%- endfor -%}
    {% else %}
      {% for i in (1..minimum_items_for_wrap_around) %}
        <div class="gallery__slide carousel__slide animates ecom-welcome">
        
          <div class="gallery__image ecom-welcome">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            
            </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
<!--   christmas page section desktop - end -->

<!--   christmas page section mobile - start -->
  <div class="{% if template == "page.christmas" %} christmasTeaAwaitsAreaOnMob {% endif %} {% if template.name == "index"  %} gallery__slides carousel__slides2 {% else %} ecom_gallery__slides {%endif %}" data-carousel3>
    
    
    
    {% if blocks.size > 0 %}
      {%- for block in blocks -%}
   
        <div class="gallery__slide carousel__slide animates {% if template == "page.christmas" %} christmasPic-{{ forloop.index }} {% endif %} {% if template.name == "index"  %} ecom-welcome {% else %} ecom_blog_header  {%endif %}" {{ block.shopify_attributes }} data-index="{{ forloop.index0 }}">

          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="{% if template == "page.christmas" %} xmas_gallery__image {% else %}gallery__image {% endif %}">
          {% else %}
            <div class="{% if template == "page.christmas" %} xmas_gallery__image {% else %}gallery__image {% endif %}">
          {% endif %}

            {% if block.settings.image != blank %}
              {% render 'image' with
                image: block.settings.image
              %}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}

          {% if block.settings.link != blank %}
            </a>
          {% else %}		
         
      </div>
          {% endif %}

          {% unless block.settings.description == blank %}
            <div
              class="gallery__description type-body-regular mt3 mb0"
              data-theme-editor-setting="section.{{ id }}.block.{{ block.id }}.description"
            >
              {{ block.settings.description }}
            </div>
          {% endunless %}
        </div>
      {%- endfor -%}
    {% else %}
      {% for i in (1..minimum_items_for_wrap_around) %}
        <div class="gallery__slide carousel__slide animates ecom-welcome">
        
          <div class="gallery__image ecom-welcome">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            
            </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
<!--   christmas page section mobile - end -->
              
{% endif %}
  
</section>
