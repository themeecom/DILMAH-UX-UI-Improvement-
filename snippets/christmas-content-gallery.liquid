        heading_alignment: carousel_text_alignment,
        text_max_width: text_max_width,
        overline: overline,
        heading: heading,
        subheading: subheading,
        link: link,
        link_text: link_text
      %}
      <ul>
        <li>xmasCelebrateTxt - {{ xmasCelebrateTxt }}</li>
        <li>image1 - <img src="{{ image1 | image_url }}"></li>
        <li>image2 - <img src="{{ image2 | image_url }}"></li>
        <li>image3 - <img src="{{ image3 | image_url }}"> </li>
        <li>image4 - <img src="{{ image4 | image_url }}"></li>
        <li>image5 - <img src="{{ image5 | image_url }}"></li>
      </ul>
    </div> -->
    <div class="xmasTopHeaderArea">
      <div class="celebratiTxtWithLogoArea">
          <div class="rightLogo">
              <h3 class="celebritiTxt">{{ xmasCelebrateTxt }}</h3>
            <img class="xmasLogo" src="{{ image1 | image_url }}">
          </div>
      </div>
      <div class="xmasTopHeaderTextBlockWithLabel">
          <div class="xmasTopTxtTopicBlock">
            {% render 'christmas-text-block' with
              id: id,
              modifiers: 'mb5 animation__staggered-children-fade-in',
              heading_alignment: carousel_text_alignment,
              text_max_width: text_max_width,
              overline: overline,
