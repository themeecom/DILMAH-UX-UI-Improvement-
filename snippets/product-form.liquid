    <div class="sub-product-img">
         <img loading="lazy" src="{{variant.image.src| img_url: "500x" }}"/>
    </div>
    
    <div class="sub-product-del">
      <p class="product-weight-{{ variant.id }}" >
       {{ variant.title }}  {%- if variant.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}
       <p>
      
    </div>
    <div class="sub-product-qty product-{{ variant.id }}">
      <div class="qty"> <input type="text" class="sub-product-qty-input input-{{ variant.id }}"></div>
      <div class="plusminusBtn">
          <div class="plus" data-value="{{ variant.id }}" data-price="{{ variant.price }}" data-weight="{{ variant.weight }}">+</div>
          <div class="minus" data-value="{{ variant.id }}" data-price="{{ variant.price }}"  data-weight="{{ variant.weight }}">-</div>
      </div> 
        
    </div>
  </div>
{% endfor %}

</div>
{%else%}

