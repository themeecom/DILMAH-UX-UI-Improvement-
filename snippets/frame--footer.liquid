<div class="ecom-footer2" style="display: none;">
  
  <div class="col4">
    
        <div class="footer__bottom mb5">
        {%- render 'cross-border' with
          show_locale: locale_selector,
          show_currency: currency_selector
        -%}

        {%- assign social_icons_in_use = false -%}

        {%- assign social_accounts = 'Facebook, Twitter, Pinterest, Instagram, Snapchat, Tumblr, YouTube, Vimeo,' | split: ', ' -%}
        {%- for social in social_accounts -%}
          {%- assign social_handle = social | handleize -%}
          {% capture social_link %}social_{{ social_handle }}_link{% endcapture %}
          {%- if settings[social_link] != blank -%}
            {%- assign social_icons_in_use = true -%}
          {%- endif -%}
        {%- endfor -%}


        {%- if social_icons_in_use -%}
          <div class="footer__social-icons">
            {%- render 'social-icons' -%}
          </div>
        {%- endif -%}
      </div>
    
  </div>
  
  <div class="col5">
    
    {% comment %}
      <h3 class="footer__col-title overline mt0 mb3"> {{ 'general.newsletter_form.title' | t }}</h3>
   {% endcomment %}
    
    {% unless newsletter_subheading == blank %}
    <div class="footer__signup-text mb3">
       {% comment %}
      {{ newsletter_subheading }}
      {% endcomment %}
      Subscribe to our email newsletter today to receive updates
    </div>
    {% endunless %}
  </div>
    
  <div class="col6">
     {% if show_newsletter_signup %}
          <div class="footer__newsletter">
            

            <div class="footer__input-wrap">

              {% form 'customer' %}
                {{ form.errors | default_errors }}
                {% if form.posted_successfully? %}
                  <p>{{ 'general.newsletter_form.confirmation' | t }}</p>
                {% else %}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <div class="newsletter__input-container">
                    <input type="email"
                      class="input-reset input"
                      name="contact[email]"
                      id="Email"
                      value="{% if customer.email != blank %}{{ customer.email }}{% endif %}"
                      placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}"
                      autocorrect="off"
                      autocapitalize="off">
                      {% comment %}<label class="label--above" for="Email">{{ 'general.newsletter_form.email_placeholder' | t }}</label> {% endcomment %}
                      <button class="footer__newsletter-button">
                        {% render 'icon-arrow-forward' %}
                      </button>
                  </div>
                {% endif %}
              {% endform %}

            </div>
          </div>
        {% endif %}
        
   </div>
  
  
</div>


<footer
  data-section-id="{{ id }}"
  data-section-type="footer"
  class="footer{{ modifiers }}"
>
  <div class="footer__container">

    {% if blocks.size > 0 or show_newsletter_signup %}
      <section class="footer__cols">
        <div class="footer_Left">
        {% for block in blocks %}

          {% if block.type == 'text' and block.settings.text != blank %}
            <div class="footer__col-text">
              <h3 class="footer__col-title overline mt0 mb3">{{ block.settings.title }}</h3>
              {% if block.settings.text %}
                <div class="rte">
                  {{ block.settings.text }}
                </div>
              {% endif %}
            </div>
          {% endif %}

          {% if block.type == 'link_list' and linklists[block.settings.menu].links.size > 0 %}
            <div class="footer__col-list">
              <h3 class="footer__col-title overline mt0 mb3 {{ linklists[block.settings.menu].title }}">{{ linklists[block.settings.menu].title }}</h3>
              {% if linklists[block.settings.menu].links.size > 0 %}
                <ul class="list ma0 pa0">
                  {% for link in linklists[block.settings.menu].links %}
                    <li class="list-item ma0"><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {% endfor %}
              
                  
                </ul>
              {% endif %}
            </div>
            
          {% endif %}
     
        
        {% endfor %}
     </div>
        <div class="footer_right">
          
          
          
          <div class="footer_logo">
            
<!--                   <img src="https://cdn.shopify.com/s/files/1/0525/3693/4552/files/Dilmah_Fresh_Logo.png?v=1631951881">
                 <img src="https://cdn.shopify.com/s/files/1/0525/3693/4552/files/Dilmah_Ethical_Logo.png?v=1631951881">
                 <img src="https://cdn.shopify.com/s/files/1/0525/3693/4552/files/Dilmah_Carbon_Neutral_Product.png?v=1631951881">
           -->
          </div>  
           
           <div class="list-item ma0 connected_icom">

             <div class="footer__col-title overline mt0 mb3">Get connected</div>
             {%- render 'social-icons' -%}

           </div>
          
          
          
         <div class="footer__col-list Newsletter_row">
           <h3 class="footer__col-title overline mt0 mb3">Newsletter</h3>
           
           
           {% if show_newsletter_signup %}
          <div class="footer__newsletter">
            

            <div class="footer__input-wrap">

              {% form 'customer' %}
                {{ form.errors | default_errors }}
                {% if form.posted_successfully? %}
                  <p>{{ 'general.newsletter_form.confirmation' | t }}</p>
                {% else %}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <div class="newsletter__input-container">
                    <input type="email"
                      class="input-reset input"
                      name="contact[email]"
                      id="Email"
                      value="{% if customer.email != blank %}{{ customer.email }}{% endif %}"
                      placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}"
                      autocorrect="off"
                      autocapitalize="off">
                      {% comment %}<label class="label--above" for="Email">{{ 'general.newsletter_form.email_placeholder' | t }}</label> {% endcomment %}
                      <button class="footer__newsletter-button">
                        {% render 'icon-arrow-forward' %}
                      </button>
                  </div>
                {% endif %}
              {% endform %}

            </div>
          </div>
        {% endif %}
           
           <div style="display:none">
           <br>
          <h3 class="footer__col-title overline mt0 mb3">Secure Shopping</h3>
           <p style="color: black;">We provide you with the fastest most secure shopping experience possible </p>
            {% if show_payment_icons %}
              <div class="footer__payment-icons mb2">
                {% unless shop.enabled_payment_types == empty %}
                  <span class="visually-hidden">{{ 'layout.footer.payment_methods' | t }}</span>
                  <ul class="payment-icons list flex ma0 pa0">
                    {% for type in shop.enabled_payment_types %}
                      <li class="footer__payment-icon">
                        {{ type | payment_type_svg_tag: class: 'icon' }}
                      </li>
                    {% endfor %}
                  </ul>
                {% endunless %}
              </div>
            {% endif %}
           <br>
           </div>
           
          
           
           
         </div>
            
        </div>
        
        
      </section>

      <hr class="footer__divider mt6-l mt5 mb3 b--solid b--default bb" style="border-top: 0; border-right: 0; border-left: 0;margin-top: 10px;" />
    {% endif %}




    <div class="footer__copyright" >
      <p>Copyright&copy;{{ 'now' | date: "%Y" }} Dilmah Ceylon Tea Company PLC. All Rights Reserved·  </p><p><a target="_blank" href="https://www.ecom.services">E-commerce Solution</a> By Ecom Services</p>
    </div>
    
    
  </div>
</footer>
<style>
  .ecom-footer1 {
    display: grid !important;
    grid-template-columns: 21% 30% 30% 19% !important;
    align-items: center;
    background: #017d85 !important;
    color: white;
    padding: 41.9px 36px !important;
  }
  
  .col_1 h1 {
    font-size: 1.3em !important;
    font-weight: 300 !important;
    letter-spacing: 1.5px !important;
    margin-bottom: 0;
    margin-top: 0;
  }
  .col_1 h4 {
    font-size: 17px !important;
    letter-spacing: 1px !important;
    margin-top: -2px !important;
    color: #bc9307 !important;
    margin-bottom: 0 !important;
  }
  .col_2 p {
    font-size: 18px !important;
    line-height: 18px !important;
    font-weight: 500 !important;
    letter-spacing: 0.2px !important;
    margin-bottom: 0 !important;
  }
  .col_3 {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
  }
  .ecom-footer1 .col_3 {
        /* grid-template-columns: repeat(8, 1fr); */
