  //update account details
async function updateAccountDetails () {
    const allProfileInputs = document.querySelectorAll(`#myProfileArea input`);
    for(let input of allProfileInputs) {
        input.classList.remove("input-error");
    }
  
    changeProfileInfoBtn.disabled = true;
    const first_name = document.querySelector(`[name="first_name"]`);
    const last_name = document.querySelector(`[name="last_name"]`);
    const phone = document.querySelector(`[name="phone"]`);
    const email = document.querySelector(`[name="email"]`);
    const dob = document.querySelector(`[name="dob"]`);
    const gender = document.querySelector(`[name="gender"]`);
    const profession = document.querySelector(`[name="profession"]`);
    const organization = document.querySelector(`[name="organization"]`);
    const customer_id = document.querySelector(`[name="customer_id"]`);
    const store_id = document.querySelector(`[name="store_id"]`);
    
    const url = "https://erp.dilmahtea.com/api/update-customer";

    const form = new FormData();
    form.append("first_name", first_name.value);
    form.append("last_name", last_name.value);
    form.append("phone",phone.value);
    form.append("email",email.value);
    form.append("dob",dob.value);
    form.append("gender",gender.value);
    form.append("profession",profession.value);
    form.append("organization",organization.value);
    form.append("customer_id",customer_id.value);
    form.append("store_id",store_id.value);

    let dotCount = 0;
    const maxDotCount = 5;
    let processingTimeout = setInterval(function(){
      let html = "Processing";
      for(let i = 0; i < dotCount; i++){
        html += ".";
      }
        
      dotCount += 1;
      if(dotCount >= maxDotCount) {
        dotCount =  0;
      }
      changeProfileInfoBtn.innerHTML = html;
      console.log("123");
    }, 200);
  
    const _fetch = await fetch(url, {
        method: "POST",
        body: form
    });

    const result = await _fetch.text();
    clearInterval(processingTimeout);
    changeProfileInfoBtn.innerHTML = "Update";
    changeProfileInfoBtn.disabled = false;
    if(result.trim() == "success") {
      showSnackBar("Your account has been updated");
    } else {
      const errorMsg = JSON.parse(result.trim());
      
      if(errorMsg.phone) {
        phone.classList.add("input-error");
        showSnackBar("Phone number is invalid. Please check and update.");
        return;
      }
      showSnackBar("Some important fields are missing. Please check and update");
    }
    console.log(result)
}
  
  function setCustomerData () {
    console.log("runnsing set custoemr")
    document.querySelector(`[name="dob"]`).value = dob.trim()
    document.querySelector(`[name="profession"]`).value = profession.trim();
    document.querySelector(`[name="organization"]`).value = orgnization.trim();

    for(let dropOption of document.querySelector(`[name="gender"]`).options) {
        if(dropOption.value.toLowerCase() == gender.toLowerCase().trim() ) {
            dropOption.selected = true;
        }
    }
    document.querySelector(`[name="gender"]`).dispatchEvent(new Event("change"));
}
window.addEventListener("DOMContentLoaded",  setCustomerData);
