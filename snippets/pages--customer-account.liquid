{% comment %} <form action="#" class="addressForm" style="display:none" id="addressForm1"> {% endcomment %}
{% form 'customer_address', customer.default_address, style:"display:none", class:"addressForm1" %}

        <div class="addressFormInput">
          <label><i class="fa fa-envelope" aria-hidden="true"></i>Email Address</label>
          <input type="email" id="email_ecom" placeholder="Enter email address">
        </div>
  
        <div class="addressFormInput">
          <label><i class="fa fa-user" aria-hidden="true"></i>First Name</label>
          <input type="text"
                  name="address[first_name]"
                  placeholder="{{ 'customer.addresses.first_name' | t }}"
                  id="AddressFirstName_ecom"
                  class="input"
                  value="{{ form.first_name }}"
                  autocapitalize="words">
        </div>

        <div class="addressFormInput">
          <label><i class="fa fa-user" aria-hidden="true"></i>Last Name</label>
          <input type="text"
                  name="address[last_name]"
                  placeholder="{{ 'customer.addresses.last_name' | t }}"
                  id="AddressLastName_ecom"
                  class="input"
                  value="{{ form.last_name }}"
                  autocapitalize="words">
        </div>

        <div class="addressFormInput">
          <label><i class="fa fa-phone" aria-hidden="true"></i>Phone Number</label>
          <input type="tel"
                  name="address[phone]"
                  placeholder="{{ 'customer.addresses.phone' | t }}"
                  id="AddressPhone_ecom"
                  class="input"
                  value="{{ form.phone }}"
                  pattern="[0-9\-]*">
        </div>

        <div class="addressFormInput">
          <label for="AddressAddress1_{{ form.id }}" class="label--above"><i class="fa fa-phone" aria-hidden="true"></i>
              Address One
            </label>
            <input type="text"
                  name="address[address1]"
                  placeholder="{{ 'customer.addresses.address1' | t }}"
                  id="AddressAddress1_ecom"
                  class="input"
                  value="{{ form.address1 }}"
                  autocapitalize="words">
        </div>

  

      <div class="addressFormInput">
        <label for="AddressAddress2_{{ form.id }}" class="label--above"><i class="fa fa-phone" aria-hidden="true"></i>
                Address Two
              </label>
  <input type="text"
                  name="address[address2]"
                  placeholder="{{ 'customer.addresses.address2' | t }}"
                  id="AddressAddress2_ecom"
                  class="input"
                  value="{{ form.address2 }}"
                  autocapitalize="words">
  </div>
       

