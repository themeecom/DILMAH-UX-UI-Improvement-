 {% paginate customer.addresses by paginate_by %}       

         {% for address in customer.addresses %}
        <div class="addressCard" id="address{{ forloop.index }}">
          <div class="cRect"></div>
          {% if address == customer.default_address %}
             <div class="cTitle"> <p>{{ 'customer.addresses.default' | t }} Address</p></div>
          {% else %}
            <div class="cTitle"> <p>Other Address</p></div>
          {% endif %}
          <div class="cInfo">
             <p class="personName"><span class="first">{{ address.first_name }}</span> <span class="last">{{ address.last_name }}</span></p>
            <p class="email">Email : <span>{{ address.email }}</span></p>
            <p class="contact">Contact : <span> {{ address.phone  }} </span></p>
            <p class="address">Address : <span class="address1"> {{ address.address1  }} </span> <span class="address2">{{ address.address2 }} </span></p>
             <p class="company"> Company : <span> {{ address.company }}</span> </p>
            <p class="city">City: <span>{{ address.city  }}</span></p>
            <p class="country">Country :<span> {{ address.country }} </span></p>
            <p class="province">Province :<span>{{ address.province }}</span></p>
            <p class="zipcode">Zip Code:<span>{{ address.zip }}</span></span>
            <button class="changeBtn" onclick="updateAddress('address{{ forloop.index }}')">Change</button>

           {% form 'customer_address', address , class:"data-ecom" %} {% endform %}
          </div>
          <div class="b-checkbox-section">
          <input type="checkbox" id="cardCheckBox"><p>Use my shipping address</p>
          </div>
        </div>
          {% endfor %}
