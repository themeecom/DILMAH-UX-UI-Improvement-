                <input type="hidden" name="customer_id" placeholder="{{ customer.id }}" value="{{ customer.id }}">
                <input type="hidden" name="store_id" placeholder="61718167738" value="61718167738">

                <table class="profileInfo">
               <tr>
                  <td>First Name</td><td> : </td><td> <input name="first_name" type="text" value="{{ customer.first_name }}"></td>
                </tr>
                <tr>
                  <td>Last Name</td><td> : </td><td><input name="last_name" type="text" value="{{ customer.last_name }}"></td>
                </tr>
                <tr>
                  <td>Phone Number</td><td> : </td><td><input name="phone" type="phone" value="{{ customer.phone }}"></td>
                </tr>
                <tr>
                  <td>Email Address</td><td> : </td><td><input type="email" name="email" value="{{ customer.email }}"></td>
                </tr> 
              </table>
              </div>
              <div class="profileAccInfoTbl">
              <table class="profileInfo">
              <tr>
                <td>D.O.B</td><td> : </td><td><input name="dob" type="date" value="{{ dob }}"></td>
              </tr>
              <tr>
                <td>Gender</td><td> : </td><td>
                  <select name="gender">
