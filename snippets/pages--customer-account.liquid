function openOrdInDetails(elemName) {
    const orderDetails = JSON.parse( document.querySelector(`#${elemName}`).innerText );
    console.log(" :- ",orderDetails);

//status:order-accepted 
//status:packing-confirmed
//status:order-processing
//status:production-closed

    const orderHeadingInPrint = document.querySelector(`.orderDetailsCard h2`);
    orderHeadingInPrint.innerText = orderDetails.orderID;

    const orderCreateDateInPrint = document.querySelector(`.orderDetailsCard h4`);
    orderCreateDateInPrint.innerText = orderDetails.create_at;

    const lineItemTable = document.querySelector(`.OrderDetails .rte-table .responsive-table.orderItem tbody`);
    lineItemTable.innerHTML = "";

    //going through the line items and show in the line items table
    for(let item of orderDetails.line_items) {
        let row = `<tr class="responsive-table-row"> `;
        row += `<td> ${item.title} </td>`;
        row += `<td> ${item.sku} </td>`;
        row += `<td> ${item.unitPrice} </td>`;
        row += `<td> ${item.qty} </td>`;
        row += `<td> ${item.total} </td>`;
        lineItemTable.innerHTML += row;
    }
    lineItemTable.innerHTML += `<tr> <td colspan="4" style="text-align: left;padding-left: 50px;">Total</td> <td>${orderDetails.total}</td> </tr>`;

    const shippingAddress = document.querySelector(".myOrdersCards .myOrdersaddressCard.shipping .cInfo");
      shippingAddress.innerHTML = orderDetails.shipping_address_elem;
    const billingAddress = document.querySelector(".myOrdersCards .myOrdersaddressCard.billing .cInfo");
    billingAddress.innerHTML = orderDetails.billing_address_elem;
    const financialStatus = document.querySelector(".myOrderStatusCards .paymentCard .status");
      financialStatus.innerHTML = orderDetails.financial_status;
    const fullfillmentStatus = document.querySelector(".myOrderStatusCards .fulfilmentCard .status");
      fullfillmentStatus.innerHTML = orderDetails.fullfilment_status;

    //show processing images 
    //get all images and add ecom hide class
    const allOrdTrackImg = document.querySelectorAll(`.order-tracking .ecomOrdImg`);
    for(let ordImg of allOrdTrackImg) {
        ordImg.classList.add("ecom_hide");
    }

    const allDefault = document.querySelectorAll(`.ecomOrdImg[class*='-default']`);
    for(let ordImg of allDefault) {
        ordImg.classList.remove("ecom_hide");
    }
    
    if(orderDetails.tag.trim() != "") {
        const tag = orderDetails.tag.trim();
        
        if(tag == "order-accepted") {
            document.querySelector(`.orderAccepted-default`).classList.add("ecom_hide");
            document.querySelector(`.orderAccepted-processing`).classList.remove("ecom_hide");
        }
        if(tag == "order-processing") {
            document.querySelector(`.orderAccepted-default`).classList.add("ecom_hide");
            document.querySelector(`.orderAccepted-processing`).classList.add("ecom_hide");
            document.querySelector(`.orderAccepted-complete`).classList.remove("ecom_hide");

            document.querySelector(`.packageConfirm-default`).classList.add("ecom_hide");
            document.querySelector(`.packageConfirm-processing`).classList.remove("ecom_hide");
        }
        if(tag == "packing-confirmed") {
           document.querySelector(`.orderAccepted-default`).classList.add("ecom_hide");
           document.querySelector(`.orderAccepted-processing`).classList.add("ecom_hide");
           document.querySelector(`.orderAccepted-complete`).classList.remove("ecom_hide");
            
            document.querySelector(`.packageConfirm-default`).classList.add("ecom_hide");
            document.querySelector(`.packageConfirm-processing`).classList.add("ecom_hide");
            document.querySelector(`.packageConfirm-complete`).classList.remove("ecom_hide");

            document.querySelector(`.orderProcessing-default`).classList.add("ecom_hide");
            document.querySelector(`.orderProcessing-processing`).classList.remove("ecom_hide");
        }
        if(tag == "production-closed") {
            document.querySelector(`.orderAccepted-default`).classList.add("ecom_hide");
           document.querySelector(`.orderAccepted-processing`).classList.add("ecom_hide");
           document.querySelector(`.orderAccepted-complete`).classList.remove("ecom_hide");
            
            document.querySelector(`.packageConfirm-default`).classList.add("ecom_hide");
            document.querySelector(`.packageConfirm-processing`).classList.add("ecom_hide");
