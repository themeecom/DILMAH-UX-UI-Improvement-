{% paginate customer.orders by 99999999999999999 %}
      {% if customer.orders.size != 0 %}

      <div class="orderCardTbl">
        <div class="orderTblRect"></div>
        <div class="ordTitle"> <p>Track Order ID : #12214</p></div>
        <div class="orderTblBody">

           <table class="responsive-table" cellspacing="0">
          <thead>
            <tr>
              <th>{{ 'customer.orders.order_number' | t }}</th>
              <th>{{ 'customer.orders.date' | t }}</th>
              <th>{{ 'customer.orders.payment_status' | t }}</th>
              <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
              <th colspan="2">{{ 'customer.orders.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {% for order in customer.orders %}
              <tr class="responsive-table-row">
                <td data-label="{{ 'customer.orders.order_number' | t }}"> {{ order.name | link_to: order.customer_url }}</td>
                <td data-label="{{ 'customer.orders.date' | t }}">{{ order.created_at | date: "%B %d, %Y" }}</td>
                <td data-label="{{ 'customer.orders.payment_status' | t }}">{{ order.financial_status_label }}</td>
                <td data-label="{{ 'customer.orders.fulfillment_status' | t }}">{{ order.fulfillment_status_label }}</td>
                <td data-label="{{ 'customer.orders.total' | t }}">{{ order.total_price | money }}</td>
                <td ><button onclick="openOrdInDetails('track{{ order.order_number }}')">Track Order</button></td>
                <script id="track{{ order.order_number }}">
                  {% assign orderStatus = "" %}
                  {% for tag in order.tags %}
                  {% if tag contains "status:" %}
                  {% assign orderStatus = tag |  replace: "status:", "" | strip  %}
                  {% endif %}
                  {% endfor %}
                      {
                        "orderID": "{{ order.name }}",
                          "create_at" : "{{ order.created_at | date: "%B %d, %Y" }}",
                          "cancel_at": "{{ order.cancelled_at | date: "%B %d, %Y" }}",
                          "payment_status" : "{{ order.fulfillment_status }}",
                          "total": "{{ order.total_price | money }}",
                          "tag" : "{{ orderStatus }}",
                        "billing_address": {
                            "email": "{{order.email}}",
                            "address1": "{{ order.billing_address.address1 }}",
                            "address2": "{{ order.billing_address.address2 }}",
                            "contact": "{{ order.billing_address.phone }}",
                            "city": "{{ order.billing_address.city }}",
                            "first_name": "{{ order.billing_address.first_name }}",
                            "last_name": "{{ order.billing_address.last_name }}",
                            "country": "{{ order.billing_address.country }}",
                            "province": "{{ order.billing_address.province }}",
                            "zip": "{{ order.billing_address.zip }}"
                        },
                        "shipping_address": {
                            "email": "{{order.email}}",
                            "address1": "{{ order.shipping_address.address1 }}",
                            "address2": "{{ order.shipping_address.address2 }}",
                            "contact": "{{ order.shipping_address.phone }}",
                            "city": "{{ order.shipping_address.city }}",
                            "first_name": "{{ order.shipping_address.first_name }}",
                            "last_name": "{{ order.shipping_address.last_name }}",
                            "country": "{{ order.shipping_address.country }}",
                            "province": "{{ order.shipping_address.province }}",
                            "zip": "{{ order.shipping_address.zip }}"
                        },
                        "financial_status": "{{ order.financial_status }}",
                        "shipping_address_elem": "{{ order.shipping_address | format_address }}",
                        "billing_address_elem": "{{ order.billing_address | format_address }}",
                        "fullfilment_status": "{{ order.fulfillment_status }}",
                        "line_items": 
                              [
                        {% for line_item in order.line_items %}
                        {
                          "title": "{{line_item.title}}",
                          "sku": "{{ line_item.sku }}",
                          "qty" : "{{ line_item.quantity }}",
                          "unitPrice": "{{ line_item.final_price | money}}",
                          "total": "{{ line_item.original_line_price | money}}"
                        } {% if forloop.last == false %}
                          ,
                            {% endif %}
                        {% endfor %}      
                        ]
                      }
                </script>
              </tr>
            {% endfor %}
          </tbody>
        </table>
    </span>
          
        </div>
    </div>
       
