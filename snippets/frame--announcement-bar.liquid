  </div> 

{% comment %} <script>
  window.addEventListener("load", ()=>{
                      
   var txtMsg_shipping="You are away $";  
   var txtMsg_shippingback="for free shipping"; 
    var res=txtMsg_shipping.concat(shipping_amount)+ " ".concat(txtMsg_shippingback);                    
    document.getElementById("msgecom").innerHTML = res;
    console.log(res);
   });
  
</script> {% endcomment %}
 
<section
  class="announcement-bar-wrapper"
  data-section-id="{{ id }}"
  data-section-type="announcement-bar"
  data-timing="{{ timing_in_ms }}"
   
  id="default-announcement-ecom"
>
  
 
  
<!-- ===========================================================old shipping-bar=================================================-->
  {% if announcement_bar_enabled %}

    {% for block in blocks %}
      <div
        class="announcement-bar flex items-center justify-center"
        style="
          background-color: {{ block.settings.background_color }};
          color: {{ block.settings.text_color }};
        "
        data-index="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >
        <div class="announcement-bar__content">
          {%- if block.settings.link != blank -%}
          
          {%if block.settings.text contains "Free Shipping"%}
            <a class="color-inherit" href="{{ block.settings.link }}" id="ecom_shipping_text"  >
              {{ block.settings.text | escape }}
            </a>
          <input type="hidden" id="ecom_free_shipping_margin" value="{{block.settings.text | escape}}">
          
            {%else%}
          <a class="color-inherit" href="{{ block.settings.link }}"  >
              {{ block.settings.text | escape }}
            </a>
 
          {%endif%}
          
          
          {%- else -%}
            {{ block.settings.text | escape }}
          {%- endif -%}
        </div>
      </div>
    {% endfor %}
  {% endif %}
</section>
<section class="top_header">

<div class="panel Top_header">
   
		 
  
<ul class="parent special-orders-wrapper">
  {% for link in linklists.top-header-navigation.links %}
    <li class="Top_nav_li"><a href="{{ link.url }}" class="top_nav_head">{{ link.title }}</a>
    {% if link.links != blank %}
      <ul class="child ">
        {% for child_link in link.links %}  
        <li class="child_list"><a href= "{{ child_link.url }}" class="chils_list_head">{{ child_link.title }}</a>
        {% if child_link.links != blank %}
          <ul class="grandchild">
          {% for grandchild_link in child_link.links %}  
            <li><a href= "{{ grandchild_link.url }}">{{ grandchild_link.title }}</a></li>
          {% endfor %}
          </ul>
        {% endif %}   
        </li>
        {% endfor %}
      </ul> 
    {% endif %} 
    </li>
  {% endfor %}
</ul>
  
  
  {% comment %}
		<ul class="special-orders-wrapper">
		
          {% for link in linklists.top-header-navigation.links %}
          
          <li class="Top_nav_li {% if link.active %} current{% endif %}"><a href="{{ link.url }}">{{ link.title }}</a></li>
          
          {% endfor %}
          
         	
		</ul>
		  {% endcomment %}
		
</div>

</section>


